---
import '../styles/boing-design-kit.css';
import '../styles/boing-theme.css';
import '../styles/design-tokens-cosmic.css';
import '../styles/boing-loader.css';
import StoneEngravingOverlay from '../components/StoneEngravingOverlay.astro';
import BoingMascot from '../components/BoingMascot.astro';

/**
 * Default document shell: shared nav, stone engraved background + neon field, mascot, footers.
 * Every route under src/pages should import this layout (see verify-site-pages-use-layout.mjs).
 */
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Optional body class: 'page-landing' = subtle slab tint; 'page-app' = hex grid on body. Primary art is StoneEngravingOverlay. */
  pageClass?: 'page-landing' | 'page-app';
}

const { title = 'Boing Network', description = 'Boing Network — Authentic. Decentralized. Optimal. Quality-Assured. Authentic L1 blockchain built from first principles.', canonical, pageClass } = Astro.props;

const siteUrl = 'https://boing.network';
const fullTitle = title === 'Boing Network' ? 'Boing Network | Authentic. Decentralized. Optimal. Quality-Assured.' : `${title} | Boing Network`;
const path = (Astro.url.pathname || '/').replace(/\/$/, '') || '';
const pathNorm = path.replace(/^\//, '');
const isTestnetApp = pathNorm === 'testnet' || pathNorm.startsWith('testnet/');
const canonicalUrl = canonical ? `${siteUrl}${canonical.startsWith('/') ? canonical : '/' + canonical}` : `${siteUrl}${path || '/'}`;
const ogImage = `${siteUrl}/og.png`;
const isAuthPage = /^testnet\/(sign-in|register|set-password)(\/|$)/.test(pathNorm);
const noindex = isAuthPage;
---

<!doctype html>
<html lang="en" class:list={[(path === '/' || path === '') && 'page-home']}>
  <head>
    <meta charset="UTF-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/logo-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/icon-only-transparent.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Boing Network — The DeFi that always bounces back!" />
    <meta property="og:site_name" content="Boing Network" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Boing Network — The DeFi that always bounces back!" />

    <!-- Additional SEO -->
    <meta name="theme-color" content="#070a0e" />
    <meta name="keywords" content="Boing, Boing Network, blockchain, DeFi, L1, cryptocurrency, boing.finance, boing.express, boing.observer, decentralized finance, wallet, block explorer" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": `${siteUrl}/#organization`,
          "name": "Boing Network",
          "url": siteUrl,
          "description": "Authentic. Decentralized. Optimal. Quality-Assured. Authentic L1 blockchain built from first principles.",
          "slogan": "The DeFi that always bounces back!",
          "logo": `${siteUrl}/assets/icon-only-transparent.png`,
          "image": ogImage,
          "sameAs": [
            "https://boing.observer",
            "https://boing.express",
            "https://boing.finance"
          ]
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "name": "Boing Network",
          "alternateName": "boing.network",
          "url": siteUrl,
          "description": "Authentic L1 blockchain built from first principles. Swap, stake, and build on the Boing ecosystem.",
          "inLanguage": "en-US",
          "publisher": { "@id": `${siteUrl}/#organization` }
        }
      ]
    })} />
  </head>
  <body class:list={[pageClass, `route-${(path || '/').replace(/^\//, '').replace(/\//g, '-') || 'index'}`, isTestnetApp && 'testnet-app']}>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <StoneEngravingOverlay />
    <BoingMascot />
    <header class="site-header site-header--bar backdrop-blur-md border-b border-[var(--border-color)] shadow-md">
      <div class="site-header-bar">
        <a href="/" class="logo flex items-center gap-2 no-underline">
          <img src="/logo.svg" alt="Boing Network" width="40" height="40" class="logo-icon flex-shrink-0" />
          <span class="font-display font-extrabold text-xl text-neon-cyan">Boing Network</span>
        </a>
        <button
          type="button"
          class="site-nav-toggle"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Open menu"
        >
          <span class="site-nav-toggle-bars" aria-hidden="true">
            <span class="site-nav-toggle-bar"></span>
            <span class="site-nav-toggle-bar"></span>
            <span class="site-nav-toggle-bar"></span>
          </span>
          <span class="site-nav-toggle-text">Menu</span>
        </button>
      </div>
      <div class="site-nav-backdrop" aria-hidden="true" tabindex="-1"></div>
      <nav id="site-nav" class="site-nav" aria-label="Main">
        {path === '/' || path === '' ? (
          <>
            <a href="#hero" class="nav-section">Overview</a>
            <a href="#pillars" class="nav-section">Pillars</a>
            <a href="#tokenomics" class="nav-section">Tokenomics</a>
            <a href="#roadmap" class="nav-section">Roadmap</a>
            <a href="#build" class="nav-section">Build</a>
            <a href="/testnet" class="nav-testnet">Dashboard</a>
            <a href="/resources" class="nav-section">Resources</a>
            <a href="/downloads" class="nav-section">Downloads</a>
          </>
        ) : isTestnetApp ? (
          <>
            <a href="/testnet" class="nav-testnet" data-testnet-nav="dashboard" id="nav-testnet-dashboard">Dashboard</a>
            <span id="nav-testnet-hub-links" class="nav-hub-links" style="display: none;" aria-label="Hub pages">
              <a href="/testnet/developers/resources" data-testnet-hub-link data-hub="developer">Resources</a>
              <a href="/testnet/developers/community" data-testnet-hub-link data-hub="developer">Community</a>
              <a href="/testnet/developers/dashboard" data-testnet-hub-link data-hub="developer">My Dashboard</a>
              <a href="/testnet/users/community" data-testnet-hub-link data-hub="user">Community</a>
              <a href="/testnet/users/quests" data-testnet-hub-link data-hub="user">Quests</a>
              <a href="/testnet/users/dashboard" data-testnet-hub-link data-hub="user">My Dashboard</a>
              <a href="/testnet/operators/dashboard" data-testnet-hub-link data-hub="operator">My Dashboard</a>
              <a href="/testnet/operators/leaderboard" data-testnet-hub-link data-hub="operator">Leaderboard</a>
              <a href="/testnet/operators/resources" data-testnet-hub-link data-hub="operator">Resources</a>
            </span>
            <a href="/testnet/developers" data-testnet-nav="developers">Developers</a>
            <a href="/testnet/users" data-testnet-nav="users">Users</a>
            <a href="/testnet/operators" data-testnet-nav="operators">Operators</a>
            <a href="/testnet/register" data-testnet-nav="register">Register</a>
            <span class="nav-site-sep" id="nav-testnet-sep" aria-hidden="true">·</span>
            <a href="/resources" class="nav-site-link" id="nav-testnet-site-resources">Resources</a>
            <span id="portal-auth" class="portal-auth-nav"></span>
            <a href="/" class="testnet-logout">Back to website</a>
          </>
        ) : (
          <>
            <a href="/" class="nav-link">Overview</a>
            <a href="/testnet" class="nav-testnet">Dashboard</a>
            <a href="/resources" class="nav-link">Resources</a>
            <a href="/downloads" class="nav-link">Downloads</a>
            <a href="/about" class="nav-link nav-link--secondary">About</a>
            <a href="/community" class="nav-link nav-link--secondary">Community</a>
          </>
        )}
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer testnet-footer" data-testnet-show>
      <p>Boing Testnet — Register and sign in to access your hub.</p>
      <div class="footer-links">
        <a href="/">Back to Boing Network</a>
        <a href="/testnet">Portal</a>
      </div>
    </footer>
    <footer class="site-footer site-footer-main" data-testnet-hide>
      <p>Boing Network — Authentic. Decentralized. Optimal. Quality-Assured. <strong>Currently in Testnet.</strong></p>
      <div class="footer-links">
        <a href="/testnet">Dashboard</a>
        <a href="/resources">Resources</a>
        <a href="/downloads">Downloads</a>
        <a href="/testnet/join">Join Testnet</a>
        <a href="/faucet">Faucet</a>
        <a href="https://boing.observer" target="_blank" rel="noopener">Explorer</a>
        <a href="https://boing.express" target="_blank" rel="noopener">Wallet</a>
        <a href="https://github.com/Boing-Network/boing.network" target="_blank" rel="noopener">GitHub</a>
        <a href="https://boing.finance" target="_blank" rel="noopener">boing.finance</a>
        <a href="/docs">Documentation</a>
      </div>
    </footer>
    <script is:inline>
      (function() {
        var p = window.location.pathname.replace(/\/$/, '') || '/';
        var isTestnet = p === '/testnet' || p.indexOf('/testnet/') === 0;
        if (isTestnet) document.body.classList.add('testnet-app');
        document.querySelector('.site-header a.testnet-logout')?.addEventListener('click', function(e) {
          e.preventDefault();
          try { localStorage.removeItem('boing_portal_session'); } catch(_){}
          window.location.href = '/';
        });
      })();
    </script>
    <script is:inline>
      (function() {
        var header = document.querySelector('.site-header');
        var toggle = document.querySelector('.site-nav-toggle');
        var nav = document.getElementById('site-nav');
        var backdrop = document.querySelector('.site-nav-backdrop');
        if (!header || !toggle || !nav) return;

        var mqDesktop = window.matchMedia('(min-width: 768px)');

        function isDesktop() {
          return mqDesktop.matches;
        }

        function openNav() {
          header.classList.add('nav-open');
          nav.removeAttribute('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          toggle.setAttribute('aria-label', 'Close menu');
          document.body.classList.add('nav-scroll-lock');
          if (backdrop) backdrop.setAttribute('aria-hidden', 'false');
        }

        function closeNav() {
          header.classList.remove('nav-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open menu');
          document.body.classList.remove('nav-scroll-lock');
          if (backdrop) backdrop.setAttribute('aria-hidden', 'true');
          if (!isDesktop()) nav.setAttribute('hidden', '');
          else nav.removeAttribute('hidden');
        }

        function isOpen() {
          return header.classList.contains('nav-open');
        }

        if (!isDesktop()) nav.setAttribute('hidden', '');

        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          if (isOpen()) closeNav();
          else openNav();
        });

        if (backdrop) {
          backdrop.addEventListener('click', closeNav);
        }

        nav.querySelectorAll('a').forEach(function(link) {
          link.addEventListener('click', closeNav);
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && isOpen()) {
            closeNav();
            toggle.focus();
          }
        });

        mqDesktop.addEventListener('change', function() {
          closeNav();
        });
      })();
    </script>
    <script is:inline src="/portal-session.js"></script>
    <script is:inline>
      (function() {
        var p = window.location.pathname.replace(/\/$/, '') || '/';
        if (p !== '/testnet' && p.indexOf('/testnet/') !== 0) return;
        var session = window.BoingPortalSession && window.BoingPortalSession.getSession();
        var dashboardLink = document.getElementById('nav-testnet-dashboard');
        var hubLinksContainer = document.getElementById('nav-testnet-hub-links');
        var navItems = document.querySelectorAll('.site-nav [data-testnet-nav]');
        if (dashboardLink) dashboardLink.href = (window.BoingPortalSession && session) ? (window.BoingPortalSession.roleAppPath(session.role) || '/testnet') : '/testnet';
        if (session) {
          if (dashboardLink) dashboardLink.style.display = 'none';
          if (hubLinksContainer) hubLinksContainer.style.display = 'none';
          var sep = document.getElementById('nav-testnet-sep');
          if (sep) sep.style.display = 'none';
          navItems.forEach(function(el) {
            el.style.display = 'none';
          });
        } else {
          if (dashboardLink) dashboardLink.style.display = '';
          if (hubLinksContainer) hubLinksContainer.style.display = 'none';
          var sep = document.getElementById('nav-testnet-sep');
          if (sep) sep.style.display = '';
          navItems.forEach(function(el) {
            var role = el.getAttribute('data-testnet-nav');
            if (role === 'developers' || role === 'users' || role === 'operators') { el.style.display = ''; return; }
            if (role === 'register') { el.style.display = ''; return; }
            if (role === 'dashboard') { el.style.display = ''; return; }
          });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }

  html {
    font-family: var(--font-sans);
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  main {
    flex: 1;
    position: relative;
    z-index: 1;
    padding-top: 4.5rem;
    min-width: 0;
  }
  body.testnet-app main {
    padding-top: 4.5rem;
  }
  body.testnet-app .breadcrumbs { margin-top: 0.5rem; }

  /* Skip link: visible on focus for keyboard users */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--bg-primary);
    color: var(--accent-teal);
    font-weight: 600;
    border: 2px solid var(--accent-teal);
    border-radius: 6px;
    text-decoration: none;
    transition: top 0.2s ease;
  }
  .skip-link:focus {
    top: 1rem;
    outline: none;
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.4);
  }

  /* Consistent focus-visible for interactive elements */
  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent-teal);
    outline-offset: 2px;
  }
  .site-header nav a:focus-visible {
    outline-offset: 4px;
  }

  .site-header--bar {
    background: color-mix(in srgb, var(--surface, #0f1419) 88%, transparent);
  }

  a {
    color: var(--accent-neon);
    text-decoration: none;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--accent-purple);
  }

  code {
    font-family: var(--font-mono);
    background: var(--bg-tertiary);
    padding: 0.2em 0.4em;
    border-radius: 6px;
    font-size: 0.9em;
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0.875rem 1.5rem;
  }
  @media (min-width: 768px) {
    .site-header {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem 1rem;
      padding: 0.875rem 2rem;
    }
  }
  body.testnet-app .site-header {
    padding: 0.75rem 1.5rem;
  }
  @media (min-width: 768px) {
    body.testnet-app .site-header {
      padding: 0.75rem 2rem;
      gap: 0.5rem 1rem;
    }
  }

  .site-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-width: 0;
    position: relative;
    z-index: 3;
  }
  @media (min-width: 768px) {
    .site-header-bar {
      width: auto;
      flex: 0 0 auto;
    }
  }

  .site-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-shrink: 0;
    min-width: 44px;
    min-height: 44px;
    padding: 0.45rem 0.7rem;
    margin: 0;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface, #0f1419) 70%, transparent);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    position: relative;
    z-index: 4;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .site-nav-toggle:hover {
    border-color: var(--accent-teal);
    color: var(--accent-teal);
  }
  .site-nav-toggle-bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 18px;
    height: 14px;
  }
  .site-nav-toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .site-header.nav-open .site-nav-toggle-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .site-header.nav-open .site-nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .site-header.nav-open .site-nav-toggle-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav-toggle-bar {
      transition: none;
    }
  }

  .site-nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }
  .site-header.nav-open .site-nav-backdrop {
    display: block;
  }

  body.nav-scroll-lock {
    overflow: hidden;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
  }
  .logo-icon {
    flex-shrink: 0;
    display: block;
    width: 40px;
    height: 40px;
    object-fit: contain;
    filter: drop-shadow(0 0 6px var(--glow-cyan-subtle));
  }

  .logo:hover .logo-icon {
    filter: drop-shadow(0 0 10px var(--glow-cyan));
  }

  .site-header nav,
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    flex-wrap: wrap;
  }
  body.testnet-app .site-header nav,
  body.testnet-app .site-nav {
    gap: 0.5rem 0.75rem;
  }
  .site-header nav a,
  .site-nav a {
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-weight: 500;
    padding: 0.35rem 0.5rem;
    line-height: 1.5;
    display: inline-block;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  body.testnet-app .site-header nav a,
  body.testnet-app .site-nav a {
    padding: 0.4rem 0.35rem;
  }

  .site-header nav a:hover,
  .site-header nav a.active,
  .site-nav a:hover,
  .site-nav a.active {
    color: var(--accent-teal);
  }
  .site-header nav a.nav-section.active,
  .site-nav a.nav-section.active {
    color: var(--accent-teal);
    border-bottom: 2px solid var(--accent-teal);
  }

  /* Testnet: far right, distinct color (amber/gold) */
  .site-header nav a.nav-testnet,
  .site-nav a.nav-testnet {
    margin-left: auto;
    color: #f59e0b;
    font-weight: 600;
  }
  .site-header nav a.nav-testnet:hover,
  .site-nav a.nav-testnet:hover {
    color: #fbbf24;
  }
  .site-header nav a.nav-link--secondary,
  .site-nav a.nav-link--secondary {
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }
  .site-header nav a.nav-link--secondary:hover,
  .site-nav a.nav-link--secondary:hover {
    color: var(--accent-teal);
  }

  /* Testnet app: show testnet footer; main nav already includes testnet links from Layout */
  body.testnet-app [data-testnet-show] { display: revert !important; }
  body.testnet-app [data-testnet-hide] { display: none !important; }
  body.testnet-app .testnet-footer { display: block !important; }
  body.testnet-app .site-footer-main { display: none !important; }
  body:not(.testnet-app) [data-testnet-show] { display: none !important; }
  body:not(.testnet-app) .site-footer-main { display: block !important; }
  body.page-home .site-footer-main { display: none !important; }
  .nav-hub-links {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem 0.75rem;
    flex-wrap: wrap;
  }
  .nav-hub-links a { white-space: nowrap; }
  .nav-site-sep { color: var(--text-tertiary); font-weight: 300; pointer-events: none; margin: 0 0.1rem; }
  .site-header nav a.nav-site-link,
  .site-nav a.nav-site-link { color: var(--text-tertiary); font-size: 0.9rem; }
  .site-header nav a.nav-site-link:hover,
  .site-nav a.nav-site-link:hover { color: var(--accent-teal); }

  /* Testnet app: logout link + portal-auth in header */
  .site-header nav a.testnet-logout,
  .site-nav a.testnet-logout {
    margin-left: auto;
    color: var(--text-tertiary);
