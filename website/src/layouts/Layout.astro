---
import '../styles/boing-design-kit.css';
import '../styles/boing-theme.css';
import '../styles/design-tokens-cosmic.css';
import '../styles/boing-loader.css';
import StoneEngravingOverlay from '../components/StoneEngravingOverlay.astro';
import BoingMascot from '../components/BoingMascot.astro';

/**
 * Default document shell: shared nav, stone engraved background + neon field, mascot, footers.
 * Every route under src/pages should import this layout (see verify-site-pages-use-layout.mjs).
 */
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Optional body class: 'page-landing' = subtle slab tint; 'page-app' = hex grid on body. Primary art is StoneEngravingOverlay. */
  pageClass?: 'page-landing' | 'page-app';
}

const { title = 'Boing Network', description = 'Boing Network — Authentic. Decentralized. Optimal. Quality-Assured. Authentic L1 blockchain built from first principles.', canonical, pageClass } = Astro.props;

const siteUrl = 'https://boing.network';
const fullTitle = title === 'Boing Network' ? 'Boing Network | Authentic. Decentralized. Optimal. Quality-Assured.' : `${title} | Boing Network`;
const path = (Astro.url.pathname || '/').replace(/\/$/, '') || '';
const pathNorm = path.replace(/^\//, '');
const isTestnetApp = pathNorm === 'testnet' || pathNorm.startsWith('testnet/');
const canonicalUrl = canonical ? `${siteUrl}${canonical.startsWith('/') ? canonical : '/' + canonical}` : `${siteUrl}${path || '/'}`;
const ogImage = `${siteUrl}/og.png`;
const isAuthPage = /^testnet\/(sign-in|register|set-password)(\/|$)/.test(pathNorm);
const noindex = isAuthPage;
const isHome = path === '/' || path === '';
const navCurrent = {
  overview: isHome,
  resources: path === '/resources' || path.startsWith('/resources/'),
  downloads: path === '/downloads' || path.startsWith('/downloads/'),
  about: path === '/about',
  community: path === '/community' || path.startsWith('/community/'),
  dashboard: pathNorm === 'testnet',
  developers: pathNorm.startsWith('testnet/developers'),
  users: pathNorm.startsWith('testnet/users'),
  operators: pathNorm.startsWith('testnet/operators'),
  register: pathNorm.startsWith('testnet/register'),
};
---

<!doctype html>
<html lang="en" class:list={[(path === '/' || path === '') && 'page-home']}>
  <head>
    <meta charset="UTF-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/logo-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/icon-only-transparent.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Boing Network — The DeFi that always bounces back!" />
    <meta property="og:site_name" content="Boing Network" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Boing Network — The DeFi that always bounces back!" />

    <!-- Additional SEO -->
    <meta name="theme-color" content="#070a0e" />
    <meta name="keywords" content="Boing, Boing Network, blockchain, DeFi, L1, cryptocurrency, boing.finance, boing.express, boing.observer, decentralized finance, wallet, block explorer" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": `${siteUrl}/#organization`,
          "name": "Boing Network",
          "url": siteUrl,
          "description": "Authentic. Decentralized. Optimal. Quality-Assured. Authentic L1 blockchain built from first principles.",
          "slogan": "The DeFi that always bounces back!",
          "logo": `${siteUrl}/assets/icon-only-transparent.png`,
          "image": ogImage,
          "sameAs": [
            "https://boing.observer",
            "https://boing.express",
            "https://boing.finance"
          ]
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "name": "Boing Network",
          "alternateName": "boing.network",
          "url": siteUrl,
          "description": "Authentic L1 blockchain built from first principles. Swap, stake, and build on the Boing ecosystem.",
          "inLanguage": "en-US",
          "publisher": { "@id": `${siteUrl}/#organization` }
        }
      ]
    })} />
  </head>
  <body class:list={[pageClass, `route-${(path || '/').replace(/^\//, '').replace(/\//g, '-') || 'index'}`, isTestnetApp && 'testnet-app']}>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <StoneEngravingOverlay />
    <BoingMascot />
    <div class="site-nav-backdrop" aria-hidden="true" tabindex="-1"></div>
    <header class="site-header">
      <div class="site-header-inner">
        <div class="site-header-bar">
          <a href="/" class="logo" aria-label="Boing Network home">
            <img src="/logo.svg" alt="" width="36" height="36" class="logo-icon" />
            <span class="logo-wordmark">Boing Network</span>
          </a>
          <button
            type="button"
            class="site-nav-toggle"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label="Open menu"
          >
            <span class="site-nav-toggle-bars" aria-hidden="true">
              <span class="site-nav-toggle-bar"></span>
              <span class="site-nav-toggle-bar"></span>
              <span class="site-nav-toggle-bar"></span>
            </span>
          </button>
        </div>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          {isHome ? (
            <>
              <div class="site-nav-cluster">
                <a href="#hero" class="nav-section" data-nav-section="hero">Overview</a>
                <a href="#pillars" class="nav-section" data-nav-section="pillars">Pillars</a>
                <a href="#tokenomics" class="nav-section" data-nav-section="tokenomics">Tokenomics</a>
                <a href="#roadmap" class="nav-section" data-nav-section="roadmap">Roadmap</a>
                <a href="#build" class="nav-section" data-nav-section="build">Build</a>
                <a href="/resources" class="nav-link">Resources</a>
                <a href="/downloads" class="nav-link">Downloads</a>
              </div>
              <div class="site-nav-actions">
                <a href="/testnet" class="nav-cta">Dashboard</a>
              </div>
            </>
          ) : isTestnetApp ? (
            <>
              <div class="site-nav-cluster">
                <a href="/testnet" class="nav-link" data-testnet-nav="dashboard" id="nav-testnet-dashboard" aria-current={navCurrent.dashboard ? 'page' : undefined}>Dashboard</a>
                <span id="nav-testnet-hub-links" class="nav-hub-links" style="display: none;" aria-label="Hub pages">
                  <a href="/testnet/developers/resources" data-testnet-hub-link data-hub="developer">Resources</a>
                  <a href="/testnet/developers/community" data-testnet-hub-link data-hub="developer">Community</a>
                  <a href="/testnet/developers/dashboard" data-testnet-hub-link data-hub="developer">My Dashboard</a>
                  <a href="/testnet/users/community" data-testnet-hub-link data-hub="user">Community</a>
                  <a href="/testnet/users/quests" data-testnet-hub-link data-hub="user">Quests</a>
                  <a href="/testnet/users/dashboard" data-testnet-hub-link data-hub="user">My Dashboard</a>
                  <a href="/testnet/operators/dashboard" data-testnet-hub-link data-hub="operator">My Dashboard</a>
                  <a href="/testnet/operators/leaderboard" data-testnet-hub-link data-hub="operator">Leaderboard</a>
                  <a href="/testnet/operators/resources" data-testnet-hub-link data-hub="operator">Resources</a>
                </span>
                <a href="/testnet/developers" class="nav-link" data-testnet-nav="developers" aria-current={navCurrent.developers ? 'page' : undefined}>Developers</a>
                <a href="/testnet/users" class="nav-link" data-testnet-nav="users" aria-current={navCurrent.users ? 'page' : undefined}>Users</a>
                <a href="/testnet/operators" class="nav-link" data-testnet-nav="operators" aria-current={navCurrent.operators ? 'page' : undefined}>Operators</a>
                <a href="/testnet/register" class="nav-link" data-testnet-nav="register" aria-current={navCurrent.register ? 'page' : undefined}>Register</a>
                <span class="nav-site-sep" id="nav-testnet-sep" hidden></span>
                <a href="/resources" class="nav-link" id="nav-testnet-site-resources">Resources</a>
              </div>
              <div class="site-nav-actions">
                <span id="portal-auth" class="portal-auth-nav"></span>
                <a href="/" class="nav-quiet testnet-logout" aria-label="Back to website">Website</a>
              </div>
            </>
          ) : (
            <>
              <div class="site-nav-cluster">
                <a href="/" class="nav-link" aria-current={navCurrent.overview ? 'page' : undefined}>Overview</a>
                <a href="/resources" class="nav-link" aria-current={navCurrent.resources ? 'page' : undefined}>Resources</a>
                <a href="/downloads" class="nav-link" aria-current={navCurrent.downloads ? 'page' : undefined}>Downloads</a>
                <a href="/about" class="nav-link" aria-current={navCurrent.about ? 'page' : undefined}>About</a>
                <a href="/community" class="nav-link" aria-current={navCurrent.community ? 'page' : undefined}>Community</a>
              </div>
              <div class="site-nav-actions">
                <a href="/testnet" class="nav-cta">Dashboard</a>
              </div>
            </>
          )}
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer testnet-footer" data-testnet-show>
      <p>Boing Testnet — Register and sign in to access your hub.</p>
      <div class="footer-links">
        <a href="/">Back to Boing Network</a>
        <a href="/testnet">Portal</a>
      </div>
    </footer>
    <footer class="site-footer site-footer-main" data-testnet-hide>
      <p>Boing Network — Authentic. Decentralized. Optimal. Quality-Assured. <strong>Currently in Testnet.</strong></p>
      <div class="footer-links">
        <a href="/testnet">Dashboard</a>
        <a href="/resources">Resources</a>
        <a href="/downloads">Downloads</a>
        <a href="/testnet/join">Join Testnet</a>
        <a href="/faucet">Faucet</a>
        <a href="https://boing.observer" target="_blank" rel="noopener">Explorer</a>
        <a href="https://boing.express" target="_blank" rel="noopener">Wallet</a>
        <a href="https://github.com/Boing-Network/boing.network" target="_blank" rel="noopener">GitHub</a>
        <a href="https://boing.finance" target="_blank" rel="noopener">boing.finance</a>
        <a href="/docs">Documentation</a>
      </div>
    </footer>
    <script is:inline>
      (function() {
        var p = window.location.pathname.replace(/\/$/, '') || '/';
        var isTestnet = p === '/testnet' || p.indexOf('/testnet/') === 0;
        if (isTestnet) document.body.classList.add('testnet-app');
        document.querySelector('.site-header a.testnet-logout')?.addEventListener('click', function(e) {
          e.preventDefault();
          try { localStorage.removeItem('boing_portal_session'); } catch(_){}
          window.location.href = '/';
        });
      })();
    </script>
    <script is:inline>
      (function() {
        var header = document.querySelector('.site-header');
        var toggle = document.querySelector('.site-nav-toggle');
        var nav = document.getElementById('site-nav');
        var backdrop = document.querySelector('.site-nav-backdrop');
        if (!header || !toggle || !nav) return;

        var mqDesktop = window.matchMedia('(min-width: 960px)');

        function isDesktop() {
          return mqDesktop.matches;
        }

        function openNav() {
          header.classList.add('nav-open');
          nav.removeAttribute('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          toggle.setAttribute('aria-label', 'Close menu');
          document.body.classList.add('nav-scroll-lock');
          if (backdrop) backdrop.setAttribute('aria-hidden', 'false');
        }

        function closeNav() {
          header.classList.remove('nav-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open menu');
          document.body.classList.remove('nav-scroll-lock');
          if (backdrop) backdrop.setAttribute('aria-hidden', 'true');
          if (!isDesktop()) nav.setAttribute('hidden', '');
          else nav.removeAttribute('hidden');
        }

        function isOpen() {
          return header.classList.contains('nav-open');
        }

        if (!isDesktop()) nav.setAttribute('hidden', '');

        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          if (isOpen()) closeNav();
          else openNav();
        });

        if (backdrop) {
          backdrop.addEventListener('click', closeNav);
        }

        nav.querySelectorAll('a').forEach(function(link) {
          link.addEventListener('click', closeNav);
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && isOpen()) {
            closeNav();
            toggle.focus();
          }
        });

        mqDesktop.addEventListener('change', function() {
          closeNav();
        });
      })();
    </script>
    <script is:inline>
      (function() {
        var nav = document.getElementById('site-nav');
        if (!nav) return;
        var links = nav.querySelectorAll('a.nav-section[data-nav-section]');
        if (!links.length) return;
        var ids = [];
        links.forEach(function(link) {
          var id = link.getAttribute('data-nav-section');
          if (id && document.getElementById(id)) ids.push(id);
        });
        if (!ids.length) return;

        function setActive(id) {
          links.forEach(function(link) {
            var on = link.getAttribute('data-nav-section') === id;
            link.classList.toggle('active', on);
            if (on) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        }

        var observer = new IntersectionObserver(function(entries) {
          var visible = entries.filter(function(e) { return e.isIntersecting; });
          if (!visible.length) return;
          visible.sort(function(a, b) { return b.intersectionRatio - a.intersectionRatio; });
          setActive(visible[0].target.id);
        }, { rootMargin: '-18% 0px -64% 0px', threshold: [0, 0.2, 0.45, 1] });

        ids.forEach(function(id) {
          observer.observe(document.getElementById(id));
        });
        setActive(ids[0]);
      })();
    </script>
    <script is:inline src="/portal-session.js"></script>
    <script is:inline>
      (function() {
        var p = window.location.pathname.replace(/\/$/, '') || '/';
        if (p !== '/testnet' && p.indexOf('/testnet/') !== 0) return;
        var session = window.BoingPortalSession && window.BoingPortalSession.getSession();
        var dashboardLink = document.getElementById('nav-testnet-dashboard');
        var hubLinksContainer = document.getElementById('nav-testnet-hub-links');
        var navItems = document.querySelectorAll('.site-nav [data-testnet-nav]');
        if (dashboardLink) dashboardLink.href = (window.BoingPortalSession && session) ? (window.BoingPortalSession.roleAppPath(session.role) || '/testnet') : '/testnet';
        if (session) {
          if (dashboardLink) dashboardLink.style.display = 'none';
          if (hubLinksContainer) hubLinksContainer.style.display = 'none';
          var sep = document.getElementById('nav-testnet-sep');
          if (sep) sep.style.display = 'none';
          navItems.forEach(function(el) {
            el.style.display = 'none';
          });
        } else {
          if (dashboardLink) dashboardLink.style.display = '';
          if (hubLinksContainer) hubLinksContainer.style.display = 'none';
          var sep = document.getElementById('nav-testnet-sep');
          if (sep) sep.style.display = '';
          navItems.forEach(function(el) {
            var role = el.getAttribute('data-testnet-nav');
            if (role === 'developers' || role === 'users' || role === 'operators') { el.style.display = ''; return; }
            if (role === 'register') { el.style.display = ''; return; }
            if (role === 'dashboard') { el.style.display = ''; return; }
          });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }

  html {
    font-family: var(--font-sans);
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  main {
    flex: 1;
    position: relative;
    z-index: 1;
    padding-top: 4.5rem;
    min-width: 0;
  }
  body.testnet-app main {
    padding-top: 4.5rem;
  }
  body.testnet-app .breadcrumbs { margin-top: 0.5rem; }

  /* Skip link: visible on focus for keyboard users */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--bg-primary);
    color: var(--accent-teal);
    font-weight: 600;
    border: 2px solid var(--accent-teal);
    border-radius: 6px;
    text-decoration: none;
    transition: top 0.2s ease;
  }
  .skip-link:focus {
    top: 1rem;
    outline: none;
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.4);
  }

  /* Consistent focus-visible for interactive elements */
  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent-teal);
    outline-offset: 2px;
  }
  .site-header a:focus-visible {
    outline-offset: 3px;
    border-radius: 8px;
  }

  a {
    color: var(--accent-neon);
    text-decoration: none;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--accent-purple);
  }

  code {
    font-family: var(--font-mono);
    background: var(--bg-tertiary);
    padding: 0.2em 0.4em;
    border-radius: 6px;
    font-size: 0.9em;
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    padding: 0.7rem 1.25rem;
    background:
      linear-gradient(180deg, rgba(6, 8, 12, 0.82) 0%, rgba(7, 10, 14, 0.58) 100%);
    backdrop-filter: blur(22px) saturate(1.2);
    -webkit-backdrop-filter: blur(22px) saturate(1.2);
    border-bottom: 1px solid rgba(0, 217, 255, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(0, 217, 255, 0.06),
      0 10px 36px rgba(0, 0, 0, 0.28);
  }
  .site-header-inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    max-width: 1280px;
    margin: 0 auto;
  }
  @media (min-width: 960px) {
    .site-header {
      padding: 0.65rem 1.75rem;
    }
    .site-header-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
    }
  }

  .site-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-width: 0;
    position: relative;
    z-index: 3;
  }
  @media (min-width: 960px) {
    .site-header-bar {
      width: auto;
      flex: 0 0 auto;
    }
  }

  .site-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    padding: 0;
    margin: 0;
    border: 1px solid rgba(0, 217, 255, 0.18);
    border-radius: 999px;
    background: rgba(15, 20, 25, 0.55);
    color: var(--text-secondary);
    cursor: pointer;
    position: relative;
    z-index: 4;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .site-nav-toggle:hover,
  .site-header.nav-open .site-nav-toggle {
    border-color: rgba(0, 217, 255, 0.45);
    color: var(--accent-teal);
    background: rgba(0, 217, 255, 0.08);
    box-shadow: 0 0 16px rgba(0, 217, 255, 0.15);
  }
  .site-nav-toggle-bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 16px;
    height: 14px;
  }
  .site-nav-toggle-bar {
    display: block;
    width: 100%;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .site-header.nav-open .site-nav-toggle-bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .site-header.nav-open .site-nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .site-header.nav-open .site-nav-toggle-bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav-toggle-bar {
      transition: none;
    }
  }

  .site-nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 29;
    background: rgba(4, 6, 10, 0.62);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  body.nav-scroll-lock .site-nav-backdrop {
    display: block;
  }

  body.nav-scroll-lock {
    overflow: hidden;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    min-width: 0;
  }
  .logo:hover,
  .logo:focus-visible {
    color: inherit;
    filter: none;
    text-shadow: none;
  }
  .logo-wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    color: var(--text-primary);
    white-space: nowrap;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }
  .logo:hover .logo-wordmark {
    color: var(--accent-teal);
    text-shadow: 0 0 12px rgba(0, 217, 255, 0.35);
  }
  .logo-icon {
    flex-shrink: 0;
    display: block;
    width: 36px;
    height: 36px;
    object-fit: contain;
    filter: drop-shadow(0 0 8px var(--glow-cyan-subtle));
    transition: filter 0.2s ease;
  }
  .logo:hover .logo-icon {
