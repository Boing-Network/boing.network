---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

/**
 * PDF library: every PDF built by scripts/generate-pdfs.js, shelved by category.
 * Page count and file size are read from public/pdfs at build time, so they stay
 * accurate after `npm run build:pdfs`.
 */
type Shelf = 'start' | 'tokenomics' | 'specs' | 'roadmap';

interface Book {
  file: string;
  title: string;
  blurb: string;
  shelf: Shelf;
  featured?: boolean;
  isNew?: boolean;
}

const SHELVES: { id: Shelf; label: string; hue: string }[] = [
  { id: 'start', label: 'Start here', hue: '#3B8CFF' },
  { id: 'tokenomics', label: 'Tokenomics', hue: '#FFB800' },
  { id: 'specs', label: 'Specs & operations', hue: '#8DB8FF' },
  { id: 'roadmap', label: 'Design & roadmap', hue: '#2563EB' },
];

const BOOKS: Book[] = [
  { file: 'BOING-NETWORK-ESSENTIALS', title: 'Network Essentials', blurb: 'Plain-English tour of Boing: products, the built-in DEX, on-chain files, parallel execution, fees and honest limits.', shelf: 'start', featured: true, isNew: true },
  { file: 'BOING-NETWORK-WHITEPAPER', title: 'Whitepaper', blurb: 'Protocol and product whitepaper for the public testnet: architecture, QA gate, DEX, wallets, activations.', shelf: 'start' },
  { file: 'BOING-NETWORK-TECHNICAL-ESSENTIALS', title: 'Technical Essentials', blurb: 'The integrator companion: RPC surface, encoding, activation heights, VM, blobs and DEX discovery.', shelf: 'start' },
  { file: 'SIX-PILLARS', title: 'Six Pillars', blurb: 'Why Boing prioritizes what it does, and how each pillar shows up in the protocol.', shelf: 'start' },
  { file: 'Executive-Summary-Pitch-Deck', title: 'Executive Summary', blurb: 'The short version for partners and investors.', shelf: 'start' },
  { file: 'FEATURES', title: 'Features Timeline', blurb: 'What shipped and when, with activation heights on the public testnet.', shelf: 'start' },
  { file: 'BOING-TOKENOMICS-AND-INCENTIVIZED-TESTNET', title: 'Tokenomics & Testnet', blurb: '1B genesis then uncapped (BN-155), the proposed allocation, and honest incentivized-testnet framing.', shelf: 'tokenomics' },
  { file: 'BOING-INITIAL-TOKENOMICS', title: 'Initial Tokenomics (draft)', blurb: 'Draft allocation tables and emission notes.', shelf: 'tokenomics' },
  { file: 'RPC-API-SPEC', title: 'JSON-RPC API', blurb: 'The full method catalog that wallets, explorers and dApps build on.', shelf: 'specs' },
  { file: 'TESTNET', title: 'Testnet Guide', blurb: 'How to join, run a node, and use the public testnet.', shelf: 'specs' },
  { file: 'RUNBOOK', title: 'Runbook', blurb: 'Operator procedures for running and recovering Boing nodes.', shelf: 'specs' },
  { file: 'QUALITY-ASSURANCE-NETWORK', title: 'Quality Assurance', blurb: 'How the protocol-level Quality Gate screens new tokens and contracts.', shelf: 'specs' },
  { file: 'QA-GATE-RULES', title: 'Quality Gate Rules', blurb: 'The concrete rules behind allow, reject and community review.', shelf: 'specs' },
  { file: 'SECURITY-STANDARDS', title: 'Security Standards', blurb: 'Security expectations for the node, wallet and ecosystem apps.', shelf: 'specs' },
  { file: 'BOING-BLOCKCHAIN-DESIGN-PLAN', title: 'Design Plan', blurb: 'The long-form design of the chain, from consensus to execution.', shelf: 'roadmap' },
  { file: 'BUILD-ROADMAP', title: 'Build Roadmap', blurb: 'What is planned next and in what order.', shelf: 'roadmap' },
  { file: 'DEVELOPMENT-AND-ENHANCEMENTS', title: 'Development & Enhancements', blurb: 'Engineering notes and enhancement tracks.', shelf: 'roadmap' },
];

const pdfDir = path.join(process.cwd(), 'public', 'pdfs');
function pdfMeta(file: string) {
  try {
    const buf = fs.readFileSync(path.join(pdfDir, `${file}.pdf`));
    const pages = (buf.toString('latin1').match(/\/Type\s*\/Page(?![a-zA-Z])/g) || []).length;
    const kb = buf.length / 1024;
    const size = kb >= 1024 ? `${(kb / 1024).toFixed(1)} MB` : `${Math.round(kb)} KB`;
    return { exists: true, pages, size };
  } catch {
    return { exists: false, pages: 0, size: '' };
  }
}

const books = BOOKS.map((b) => ({ ...b, ...pdfMeta(b.file) })).filter((b) => b.exists);
const hueFor = (s: Shelf) => SHELVES.find((x) => x.id === s)!.hue;
const totalPages = books.reduce((n, b) => n + b.pages, 0);
---

<Layout
  title="PDF Library"
  description="Every Boing Network paper as a downloadable PDF: essentials, whitepaper, tokenomics, specs and roadmap."
  canonical="/library"
>
  <article class="library-page">
    <header class="library-hero full-width">
      <div class="library-hero-inner">
        <div class="hero-copy">
          <span class="stage-badge">Library</span>
          <h1 class="library-title">The Boing PDF library</h1>
          <p class="library-lead">
            Every paper we publish, ready to read offline, print or share.
            <span class="library-stats">{books.length} documents · {totalPages} pages</span>
          </p>
        </div>

        <div class="page-fan" aria-hidden="true">
          <span class="sheet sheet-1"></span>
          <span class="sheet sheet-2"></span>
          <span class="sheet sheet-3"></span>
          <span class="sheet sheet-4">
            <span class="sheet-line w80"></span>
            <span class="sheet-line w60"></span>
            <span class="sheet-line w90"></span>
            <span class="sheet-line w40"></span>
            <span class="sheet-badge">PDF</span>
          </span>
          <span class="orbit-dot d1"></span>
          <span class="orbit-dot d2"></span>
          <span class="orbit-dot d3"></span>
        </div>
      </div>
    </header>

    <nav class="shelf-filters full-width" aria-label="Filter documents">
      <div class="shelf-filters-inner" role="group">
        <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">All</button>
        {SHELVES.map((s) => (
          <button type="button" class="chip" data-filter={s.id} aria-pressed="false" style={`--hue:${s.hue}`}>{s.label}</button>
        ))}
      </div>
    </nav>

    <section class="library-grid full-width" aria-label="Documents">
      <ul class="library-grid-inner">
        {books.map((b, i) => (
          <li class:list={['book', b.featured && 'book--featured']} data-shelf={b.shelf} style={`--hue:${hueFor(b.shelf)}; --i:${i}`}>
            <a href={`/pdfs/${b.file}.pdf`} target="_blank" rel="noopener" class="book-link">
              <span class="book-3d" aria-hidden="true">
                <span class="book-pages"></span>
                <span class="book-cover">
                  <span class="book-spine"></span>
                  <span class="book-cover-icon"><Icon name="pdf" size={30} /></span>
                  <span class="book-cover-title">{b.title}</span>
                  <span class="book-sheen"></span>
                </span>
              </span>
              <span class="book-body">
                <span class="book-meta">
                  <span class="book-shelf">{SHELVES.find((s) => s.id === b.shelf)!.label}</span>
                  {b.isNew && <span class="book-new">Updated</span>}
                </span>
                <h2 class="book-title">{b.title}</h2>
                <p class="book-blurb">{b.blurb}</p>
                <span class="book-foot">
                  <span>{b.pages} pages · {b.size}</span>
                  <span class="book-cta">Open PDF <span class="arrow">→</span></span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <p class="library-note full-width">
      Sources live in <a href="https://github.com/Boing-Network/boing.network/tree/main/docs" target="_blank" rel="noopener">docs/</a> on GitHub.
      Prefer reading in the browser? See <a href="/about">About</a> or the <a href="https://docs.boing.network">docs site</a>.
    </p>
  </article>
</Layout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const books = Array.from(document.querySelectorAll<HTMLElement>('.library-page .book'));

  // Reveal books as they scroll into view (staggered "pulled off the shelf").
  if (!reduce && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('library-anim');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
    );
    books.forEach((b) => io.observe(b));
  } else {
    books.forEach((b) => b.classList.add('is-in'));
  }

  // Pointer-follow tilt on the 3D cover (fine pointers only).
  if (!reduce && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    books.forEach((book) => {
      const cover = book.querySelector<HTMLElement>('.book-3d');
      if (!cover) return;
      book.addEventListener('pointermove', (ev) => {
        const r = book.getBoundingClientRect();
        const x = (ev.clientX - r.left) / r.width - 0.5;
        const y = (ev.clientY - r.top) / r.height - 0.5;
        cover.style.setProperty('--tx', `${(x * 14).toFixed(2)}deg`);
        cover.style.setProperty('--ty', `${(-y * 10).toFixed(2)}deg`);
      });
      book.addEventListener('pointerleave', () => {
        cover.style.removeProperty('--tx');
        cover.style.removeProperty('--ty');
      });
    });
  }

  // Shelf filters.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.shelf-filters .chip'));
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', String(on));
      });
      let n = 0;
      books.forEach((b) => {
        const show = f === 'all' || b.dataset.shelf === f;
        b.hidden = !show;
        if (show) {
          b.style.setProperty('--i', String(n++));
          if (!reduce) {
            b.classList.remove('is-in');
            void b.offsetWidth; // restart the entrance animation
            b.classList.add('is-in');
          }
        }
      });
    });
  });
</script>

<style>
  .full-width { width: 100%; max-width: 100vw; box-sizing: border-box; }

  /* ---------- Hero ---------- */
  .library-hero {
    padding: 4.5rem 0 3.5rem;
    background:
      radial-gradient(ellipse 60% 80% at 80% 40%, rgba(59, 140, 255, 0.14), transparent 70%),
      linear-gradient(180deg, rgba(59, 140, 255, 0.06) 0%, transparent 70%);
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
  }
  .library-hero-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 2rem;
    display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: center;
  }
  .hero-copy > * {
    opacity: 0; transform: translateY(16px);
    animation: lib-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-copy > :nth-child(2) { animation-delay: 0.08s; }
  .hero-copy > :nth-child(3) { animation-delay: 0.16s; }
  @keyframes lib-rise { to { opacity: 1; transform: none; } }

  .stage-badge {
    display: inline-block; padding: 0.35rem 0.85rem; margin-bottom: 1rem;
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    color: #FFB800; background: rgba(255, 184, 0, 0.15);
    border: 1px solid rgba(255, 184, 0, 0.4); border-radius: 999px;
  }
  .library-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(2rem, 4.5vw, 3rem); margin: 0 0 0.75rem;
    background: linear-gradient(100deg, #8DB8FF 0%, #3B8CFF 40%, #FFB800 60%, #8DB8FF 100%);
    background-size: 250% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: lib-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.08s forwards, lib-shimmer 7s ease-in-out 1s infinite;
  }
  @keyframes lib-shimmer { 0%, 100% { background-position: 0% 0; } 50% { background-position: 100% 0; } }
  .library-lead { font-size: 1.15rem; color: var(--text-secondary); margin: 0; max-width: 520px; line-height: 1.6; }
  .library-stats { display: block; margin-top: 0.5rem; font-size: 0.9rem; color: var(--accent-teal); font-weight: 600; }

  /* Fanning stack of pages */
  .page-fan { position: relative; height: 260px; perspective: 900px; }
  .sheet {
    position: absolute; left: 50%; top: 50%;
    width: 150px; height: 196px; margin: -98px 0 0 -75px;
    border-radius: 10px;
    background: linear-gradient(160deg, #0f1d3d 0%, #0A1128 100%);
    border: 1px solid rgba(141, 184, 255, 0.35);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    transform-origin: 50% 100%;
    animation: fan-open 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards, fan-float 6s ease-in-out 1.2s infinite;
  }
  .sheet-1 { --r: -24deg; --x: -70px; animation-delay: 0.15s, 1.2s; opacity: 0.55; }
  .sheet-2 { --r: -9deg; --x: -24px; animation-delay: 0.25s, 1.35s; opacity: 0.75; }
  .sheet-3 { --r: 8deg; --x: 26px; animation-delay: 0.35s, 1.5s; opacity: 0.9; }
  .sheet-4 {
    --r: 20deg; --x: 72px; animation-delay: 0.45s, 1.65s;
    background: linear-gradient(160deg, #13284f 0%, #0b1530 100%);
    border-color: rgba(59, 140, 255, 0.7);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), 0 0 30px rgba(59, 140, 255, 0.25);
    padding: 26px 18px; box-sizing: border-box; display: flex; flex-direction: column; gap: 10px;
  }
  @keyframes fan-open {
    from { transform: translateX(0) rotate(0) translateY(30px); }
    to { transform: translateX(var(--x)) rotate(var(--r)) translateY(0); }
  }
  @keyframes fan-float {
    0%, 100% { transform: translateX(var(--x)) rotate(var(--r)) translateY(0); }
    50% { transform: translateX(var(--x)) rotate(calc(var(--r) * 1.12)) translateY(-8px); }
  }
  .sheet-line { height: 6px; border-radius: 3px; background: rgba(141, 184, 255, 0.35); }
  .sheet-line.w80 { width: 80%; } .sheet-line.w60 { width: 60%; } .sheet-line.w90 { width: 90%; } .sheet-line.w40 { width: 40%; }
  .sheet-badge {
    margin-top: auto; align-self: flex-start;
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em; color: #040814;
    background: #FFB800; padding: 0.2rem 0.55rem; border-radius: 4px;
  }
  .orbit-dot {
    position: absolute; left: 50%; top: 50%; width: 8px; height: 8px; border-radius: 50%;
    background: #3B8CFF; box-shadow: 0 0 12px #3B8CFF;
    animation: orbit 9s linear infinite;
  }
  .orbit-dot.d2 { background: #FFB800; box-shadow: 0 0 12px #FFB800; animation-duration: 12s; animation-direction: reverse; }
  .orbit-dot.d3 { width: 5px; height: 5px; background: #8DB8FF; animation-duration: 15s; animation-delay: -5s; }
  @keyframes orbit {
    from { transform: rotate(0deg) translateX(150px) rotate(0deg); }
    to { transform: rotate(360deg) translateX(150px) rotate(-360deg); }
  }

  /* ---------- Filters ---------- */
  .shelf-filters { padding: 1.25rem 0 0.5rem; }
  .shelf-filters-inner { max-width: 1200px; margin: 0 auto; padding: 0 2rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    --hue: #3B8CFF;
    font: inherit; font-size: 0.85rem; font-weight: 600; cursor: pointer;
    padding: 0.45rem 1rem; border-radius: 999px;
    color: var(--text-secondary); background: rgba(4, 8, 20, 0.6);
    border: 1px solid var(--border-color);
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .chip:hover { color: var(--text-primary); border-color: var(--hue); transform: translateY(-1px); }
  .chip:focus-visible { outline: 2px solid var(--hue); outline-offset: 2px; }
  .chip.is-active { color: #040814; background: var(--hue); border-color: var(--hue); }

  /* ---------- Grid of books ---------- */
  .library-grid { padding: 1.5rem 0 3rem; }
  .library-grid-inner {
    list-style: none; margin: 0 auto; max-width: 1200px; padding: 0 2rem;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 400px), 1fr)); gap: 1.5rem;
  }
  .book { --hue: #3B8CFF; perspective: 1000px; }
  .book[hidden] { display: none; }
  .book--featured { grid-column: span 2; }

  /* Entrance: tip forward off the shelf and settle (only when JS enables it). */
  :global(html.library-anim) .book:not(.is-in) { opacity: 0; }
  :global(html.library-anim) .book.is-in {
    animation: book-drop 0.75s cubic-bezier(0.22, 1.2, 0.36, 1) both;
    animation-delay: calc(min(var(--i), 10) * 60ms);
  }
  @keyframes book-drop {
    0% { opacity: 0; transform: translateY(-28px) rotateX(-55deg); transform-origin: 50% 0; }
    70% { opacity: 1; }
    100% { opacity: 1; transform: none; transform-origin: 50% 0; }
  }

  .book-link {
    position: relative; height: 100%;
    display: grid; grid-template-columns: 112px 1fr; gap: 1.25rem; align-items: start;
    padding: 1.5rem; border-radius: 1rem; text-decoration: none; color: inherit;
    background: linear-gradient(168deg, var(--stone-deep, #040814) 0%, var(--stone-mid, #0A1128) 100%);
    border: 1px solid var(--border-color);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }
  .book-link::before {
    /* glowing shelf edge that sweeps in on hover */
    content: ''; position: absolute; left: 1.5rem; right: 1.5rem; bottom: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--hue), transparent);
    transform: scaleX(0); transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .book-link:hover, .book-link:focus-visible {
    border-color: color-mix(in srgb, var(--hue) 55%, transparent);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3), 0 0 24px color-mix(in srgb, var(--hue) 22%, transparent);
    transform: translateY(-4px);
  }
  .book-link:hover::before, .book-link:focus-visible::before { transform: scaleX(1); }
  .book-link:focus-visible { outline: 2px solid var(--hue); outline-offset: 3px; }

  /* 3D cover */
  .book-3d {
    --tx: 0deg; --ty: 0deg;
    position: relative; display: block; width: 112px; height: 148px;
    transform-style: preserve-3d;
    transform: rotateY(calc(-14deg + var(--tx))) rotateX(var(--ty));
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .book-pages {
    position: absolute; inset: 5px 2px 5px 8px; border-radius: 0 6px 6px 0;
    background:
      linear-gradient(90deg, rgba(4, 8, 20, 0.55), transparent 30%),
      repeating-linear-gradient(180deg, transparent 0 14px, color-mix(in srgb, var(--hue) 30%, transparent) 14px 15px),
      linear-gradient(160deg, #b9c6de 0%, #8fa0c2 100%);
    transform: translateZ(-10px);
    box-shadow: 6px 10px 20px rgba(0, 0, 0, 0.45);
  }
  .book-cover {
    position: absolute; inset: 0; border-radius: 4px 8px 8px 4px; overflow: hidden;
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 14px 12px 12px 18px; box-sizing: border-box;
    background:
      radial-gradient(circle at 80% 10%, color-mix(in srgb, var(--hue) 55%, transparent), transparent 60%),
      linear-gradient(160deg, color-mix(in srgb, var(--hue) 35%, #0A1128) 0%, #070d20 100%);
    border: 1px solid color-mix(in srgb, var(--hue) 50%, transparent);
    transform-origin: 0 50%;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .book-spine {
    position: absolute; left: 0; top: 0; bottom: 0; width: 7px;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.45), color-mix(in srgb, var(--hue) 70%, #000));
  }
  .book-cover-icon { color: var(--hue); }
  .book-cover-title {
    font-family: var(--font-display); font-size: 0.78rem; font-weight: 700; line-height: 1.25;
    color: #fff; text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }
  .book-sheen {
    position: absolute; inset: -40%;
    background: linear-gradient(115deg, transparent 40%, rgba(255, 255, 255, 0.28) 50%, transparent 60%);
    transform: translateX(-60%); transition: transform 0.9s ease;
    pointer-events: none;
  }
  .book-link:hover .book-3d, .book-link:focus-visible .book-3d { transform: rotateY(calc(-24deg + var(--tx))) rotateX(var(--ty)) translateY(-4px); }
  .book-link:hover .book-cover, .book-link:focus-visible .book-cover { transform: rotateY(-26deg); }
  .book-link:hover .book-sheen, .book-link:focus-visible .book-sheen { transform: translateX(60%); }

  /* Text */
  .book-body { display: flex; flex-direction: column; min-height: 148px; }
  .book-meta { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.35rem; }
  .book-shelf { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--hue); }
  .book-new {
    font-size: 0.68rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
    color: #040814; background: #FFB800; padding: 0.1rem 0.45rem; border-radius: 999px;
    animation: new-pulse 2.4s ease-in-out infinite;
  }
  @keyframes new-pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(255, 184, 0, 0.5); } 50% { box-shadow: 0 0 0 6px rgba(255, 184, 0, 0); } }
  .book-title { font-size: 1.15rem; margin: 0 0 0.4rem; color: var(--text-primary); }
  .book-blurb { font-size: 0.92rem; line-height: 1.5; color: var(--text-secondary); margin: 0 0 0.9rem; flex: 1; }
  .book-foot { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.82rem; color: var(--text-secondary); }
  .book-cta { font-weight: 700; color: var(--hue); white-space: nowrap; }
  .book-cta .arrow { display: inline-block; transition: transform 0.3s ease; }
  .book-link:hover .arrow { transform: translateX(4px); }

  .book--featured .book-link { grid-template-columns: 150px 1fr; background: linear-gradient(168deg, #0b1a36 0%, #0A1128 100%); }
  .book--featured .book-3d { width: 150px; height: 198px; }
  .book--featured .book-cover-title { font-size: 1rem; }
  .book--featured .book-title { font-size: 1.5rem; }
  .book--featured .book-body { min-height: 198px; }

  .library-note { max-width: 1200px; margin: 0 auto 4rem; padding: 0 2rem; color: var(--text-secondary); font-size: 0.9rem; }
  .library-note a { color: var(--accent-teal); }

  /* ---------- Responsive ---------- */
