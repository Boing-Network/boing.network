---
import Layout from '../layouts/Layout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { BOOTNODES_CSV, TESTNET_CHAIN_ID, TESTNET_RPC_URL } from '../config/testnet';

const localNode = `./boing-node --rpc-port 8545 --data-dir ./data
# Optional: produce blocks locally
./boing-node --validator --rpc-port 8545 --data-dir ./data`;

const publicPeer = `export BOING_CHAIN_ID=${TESTNET_CHAIN_ID}
./boing-node \\
  --data-dir ./boing-data \\
  --p2p-listen /ip4/0.0.0.0/tcp/4001 \\
  --bootnodes ${BOOTNODES_CSV} \\
  --rpc-port 8545`;
---

<Layout
  title="Single node vs multi-node"
  description="When to run a single Boing node vs joining the public multi-node testnet."
>
  <article class="page-wrap-full">
    <header class="page-hero-full">
      <div class="page-wrap-inner">
        <span class="stage-badge-global">Testnet · chain {TESTNET_CHAIN_ID}</span>
        <h1>Single node vs multi-node</h1>
        <p class="lead">
          Pick one: a <strong>private local chain</strong> on your machine, or a node that
          <strong>joins the public testnet</strong> and syncs with everyone else.
        </p>
      </div>
    </header>
    <div class="page-wrap-inner single-multi-content">
    <section class="section">
      <h2>1. Single node (local only)</h2>
      <p><strong>Use when:</strong> you are developing on a laptop and do not need the live network.</p>
      <p>Do <strong>not</strong> pass <code>--p2p-listen</code> or <code>--bootnodes</code>. Your machine is the whole chain.</p>
      <CodeBlock code={localNode} label="Local single node" />
      <p>RPC: <code>http://127.0.0.1:8545/</code>. This does <strong>not</strong> sync with <code>{TESTNET_RPC_URL}</code>.</p>
    </section>

    <section class="section">
      <h2>2. Multi-node (public testnet)</h2>
      <p><strong>Use when:</strong> you want to peer with chain <strong>{TESTNET_CHAIN_ID}</strong>, help soak the network, or become a validator later.</p>
      <p>Pass <code>--p2p-listen</code> and the official <code>--bootnodes</code> address. Open inbound <strong>TCP 4001</strong> if others should dial you.</p>
      <CodeBlock code={publicPeer} label="Join the public testnet" />
      <p>
        Next: <a href="/bootnodes">Bootnodes</a> ·
        <a href="/testnet/join#run-a-node">Join Testnet — run a node</a> ·
        <a href="/testnet/operators/validator">Become a validator</a>
      </p>
    </section>

    <section class="section comparison">
      <h2>Quick comparison</h2>
      <table class="compare-table">
        <thead>
          <tr><th></th><th>Single node</th><th>Public testnet peer</th></tr>
        </thead>
        <tbody>
          <tr><td>Talks to other nodes</td><td>No</td><td>Yes (<code>--p2p-listen</code>)</td></tr>
          <tr><td>Bootnode</td><td>Not needed</td><td>Required (<code>--bootnodes</code>)</td></tr>
          <tr><td>Shares live chain history</td><td>No — your own chain</td><td>Yes — syncs with peers</td></tr>
          <tr><td>Best for</td><td>Local dApp work</td><td>Operators and soak testing</td></tr>
        </tbody>
      </table>
    </section>

    <nav class="section nav-links">
      <a href="/testnet/join">← Join Testnet</a>
      <a href="/bootnodes">Bootnodes →</a>
    </nav>
    </div>
  </article>
</Layout>

<style>
  .single-multi-content { padding-bottom: 3rem; }
  .page-hero-full h1 { color: var(--text-primary); }
  .lead { color: var(--text-secondary); font-size: 1.1rem; }
  .section { margin-top: 2rem; }
  .section h2 { font-size: 1.25rem; color: var(--text-primary); margin-bottom: 0.5rem; }
  .section p { color: var(--text-secondary); }
  .section code { background: rgba(255,255,255,0.08); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
  .compare-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .compare-table th, .compare-table td { padding: 0.6rem 0.75rem; text-align: left; border: 1px solid rgba(34,211,238,0.2); color: var(--text-secondary); }
  .compare-table th { color: var(--text-primary); background: rgba(6,182,212,0.08); }
  .compare-table code { background: rgba(255,255,255,0.06); padding: 0.1rem 0.3rem; border-radius: 4px; }
  .nav-links { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  .nav-links a { color: var(--accent-teal); font-weight: 500; }
  .comparison {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    min-width: 0;
  }
  @media (max-width: 640px) {
    .single-multi-content { padding-bottom: 2rem; }
    .compare-table { font-size: 0.85rem; }
    .compare-table th,
    .compare-table td { padding: 0.45rem 0.5rem; }
  }
</style>
