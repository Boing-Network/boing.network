---
import Layout from '../../layouts/Layout.astro';
import IncentivizedTestnetNotice from '../../components/IncentivizedTestnetNotice.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/hub-common.css';
---

<Layout
  title="Testnet Hub — Boing Network"
  description="Boing Network public testnet hub (chain 6913): join as user, developer, or operator. Express, Finance, Observer quests recorded in your Testnet Passport."
>
  <article class="portal-page portal-entry page-wrap-full">
    <script is:inline src="/portal-session.js"></script>
    <div class="portal-entry-inner page-wrap-inner">
    <div class="portal-hero fade-in-up">
      <span class="stage-badge-global hub-chain-badge">Public testnet · chain 6913</span>
      <h1 class="portal-hero-title"><Icon name="portal" size={36} class="title-icon" /> Testnet Hub</h1>
      <p class="lead portal-hero-lead fade-in-up delay-1">
        One place to <strong>practice</strong> on chain 6913 — faucet, Express / Finance / Observer, and peer nodes —
        and follow the path toward a future incentivized phase without treating practice as a mainnet claim.
        Optional portal registration is available for each role when you want progress tracked.
      </p>
      <div class="hero-ctas fade-in-up delay-2">
        <a href="/faucet" class="btn btn-primary">Get faucet BOING</a>
        <a href="/testnet/join" class="btn btn-secondary">RPC &amp; run a node</a>
        <a href="/testnet/users/quests" class="btn btn-secondary">Practice quests</a>
        <a href="/testnet/passport" class="btn btn-secondary">My Passport</a>
        <a href="/testnet/passport/leaderboard" class="btn btn-secondary">Leaderboards</a>
        <a href="/testnet/register" class="btn btn-secondary">Register (optional)</a>
        <a href="/testnet/sign-in" class="btn btn-secondary">Sign in</a>
      </div>
    </div>

    <IncentivizedTestnetNotice />

    <section class="section section-honesty fade-in-up delay-1" id="honesty">
      <h2>Honest limits</h2>
      <ul class="honesty-list">
        <li><strong>Testnet only</strong> — mainnet (6914) is not live; no TGE date here.</li>
        <li><strong>Single hosted validator path</strong> for day-to-day public traffic (<code>boing-testnet-1</code>); not multi-region HA.</li>
        <li><strong>No incentivized rewards</strong> until rules are published and marked live.</li>
        <li><strong>Testnet BOING</strong> has no cash value.</li>
      </ul>
      <p class="muted">
        More: <a href="/pdfs/BOING-TOKENOMICS-AND-INCENTIVIZED-TESTNET.pdf" target="_blank" rel="noopener">Tokenomics &amp; testnet (PDF)</a>
        · <a href="/pdfs/BOING-INITIAL-TOKENOMICS.pdf" target="_blank" rel="noopener">Initial tokenomics draft (PDF)</a>
        · <a href="/pdfs/TESTNET.pdf" target="_blank" rel="noopener">TESTNET guide (PDF)</a>
      </p>
    </section>

    <section class="section section-roles fade-in-up delay-1" id="roles">
      <h2>Choose your hub</h2>
      <p class="muted">Each role has its own dashboard, community view, and resources.</p>
      <div class="role-cards">
        <a href="/testnet/users" class="role-card">
          <span class="role-card__icon"><Icon name="quest" size={28} /></span>
          <h3>Community users</h3>
          <p>Faucet, Express / Finance / Observer quests, feedback.</p>
          <span class="role-card__cta">Open user hub →</span>
        </a>
        <a href="/testnet/developers" class="role-card">
          <span class="role-card__icon"><Icon name="rocket" size={28} /></span>
          <h3>Developers</h3>
          <p>SDK, deploy, register dApps, bug reports.</p>
          <span class="role-card__cta">Open developer hub →</span>
        </a>
        <a href="/testnet/operators" class="role-card">
          <span class="role-card__icon"><Icon name="node" size={28} /></span>
          <h3>Operators</h3>
          <p>Bootnodes, validator guide, leaderboard practice.</p>
          <span class="role-card__cta">Open operator hub →</span>
        </a>
      </div>
    </section>

    <section class="section section-ecosystem fade-in-up delay-1" id="ecosystem">
      <h2>Ecosystem tasks</h2>
      <p class="muted">Practice the real apps on chain 6913. These are soak tasks — not a rewards claim.</p>
      <div class="eco-cards">
        <a href="https://boing.express" target="_blank" rel="noopener" class="eco-card">
          <h3>Express</h3>
          <p>Wallet (recommended 0.1.24) — create an account, Validate tab.</p>
        </a>
        <a href="https://boing.finance" target="_blank" rel="noopener" class="eco-card">
          <h3>Finance</h3>
          <p>Swap, pools, portfolio, and bridge on the native DEX.</p>
        </a>
        <a href="https://boing.observer" target="_blank" rel="noopener" class="eco-card">
          <h3>Observer</h3>
          <p>Explorer — blocks, accounts, QA visibility.</p>
        </a>
        <a href="/faucet" class="eco-card">
          <h3>Faucet</h3>
          <p>Free testnet BOING for fees and validator bonds.</p>
        </a>
        <a href="/testnet/join" class="eco-card">
          <h3>Join / run a node</h3>
          <p>RPC, bootnode, and copy-paste peer node steps.</p>
        </a>
      </div>
    </section>

    <section class="section section-how-it-works fade-in-up delay-1" id="how-it-works">
      <h2>How it works</h2>
      <p class="muted">Start with soak practice. Portal registration is optional and does not unlock rewards today.</p>
      <div class="testnet-how-it-works">
        <div class="testnet-how-it-works__connector" aria-hidden="true"></div>
        <div class="testnet-how-it-works__steps">
          <div class="testnet-step testnet-step--1">
            <span class="testnet-step__num" aria-hidden="true">1</span>
            <h3 class="testnet-step__title">Soak the apps</h3>
            <p class="testnet-step__desc">Faucet → Express / Finance / Observer. Activity may count toward your Testnet Passport — not a promise of tokens.</p>
          </div>
          <div class="testnet-step testnet-step--2">
            <span class="testnet-step__num" aria-hidden="true">2</span>
            <h3 class="testnet-step__title">Pick a hub</h3>
            <p class="testnet-step__desc">Users, Developers, or Operators — each has quests, resources, or peer/validator steps.</p>
          </div>
          <div class="testnet-step testnet-step--3">
            <span class="testnet-step__num" aria-hidden="true">3</span>
            <h3 class="testnet-step__title">Register if you want</h3>
            <p class="testnet-step__desc">Optional portal account to track quests or dApps. Not required to use the faucet or apps.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-glance fade-in-up delay-1" id="network-glance">
      <h2>Network at a glance</h2>
      <p class="muted">Live testnet activity from the portal API. If it cannot be reached, the numbers show as unavailable and you can retry.</p>
      <div class="testnet-glance" id="testnet-glance">
        <div class="testnet-glance__card">
          <span class="testnet-glance__value" id="glance-quests">—</span>
          <span class="testnet-glance__label">Quest completions</span>
        </div>
        <div class="testnet-glance__card">
          <span class="testnet-glance__value" id="glance-dapps">—</span>
          <span class="testnet-glance__label">dApps registered</span>
        </div>
      </div>
      <p class="muted testnet-glance__status" id="glance-status" role="status" aria-live="polite"></p>
      <button type="button" class="btn btn-secondary" id="glance-retry" hidden>Retry</button>
    </section>

    </div>
  </article>
</Layout>

<script>
  (function () {
    var session = window.BoingPortalSession && window.BoingPortalSession.getSession();
    if (!session) return;
    var path = window.BoingPortalSession ? window.BoingPortalSession.roleAppPath(session.role) : '/testnet';
    if (path && path !== '/testnet') {
      window.location.href = path;
      return;
    }
  })();
</script>
<script>
  (function () {
    var questsEl = document.getElementById('glance-quests');
    var dappsEl = document.getElementById('glance-dapps');
    var statusEl = document.getElementById('glance-status');
    var retryBtn = document.getElementById('glance-retry');
    if (!questsEl && !dappsEl) return;

    function fetchJson(url) {
      return fetch(url).then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      });
    }
    function load() {
      if (retryBtn) retryBtn.hidden = true;
      if (statusEl) statusEl.textContent = 'Loading live numbers…';
      if (questsEl) questsEl.textContent = '…';
      if (dappsEl) dappsEl.textContent = '…';
      var problems = [];
      var q = fetchJson('/api/portal/quests-stats').then(function (d) {
        if (d && d.ok && d.total_completions != null) { if (questsEl) questsEl.textContent = String(d.total_completions); }
        else throw new Error('unexpected response');
      }).catch(function (e) {
        if (questsEl) questsEl.textContent = 'Unavailable';
        problems.push('quest completions (' + e.message + ')');
      });
      var d2 = fetchJson('/api/portal/dapps').then(function (d) {
        if (d && d.ok && Array.isArray(d.dapps)) { if (dappsEl) dappsEl.textContent = String(d.dapps.length); }
        else throw new Error('unexpected response');
      }).catch(function (e) {
        if (dappsEl) dappsEl.textContent = 'Unavailable';
        problems.push('registered dApps (' + e.message + ')');
      });
      Promise.all([q, d2]).then(function () {
        if (problems.length) {
          if (statusEl) statusEl.textContent = 'Could not load ' + problems.join(' and ') + '. The portal API may be offline or you may be offline.';
          if (retryBtn) retryBtn.hidden = false;
        } else if (statusEl) {
          statusEl.textContent = 'Updated ' + new Date().toLocaleTimeString() + '.';
        }
      });
    }
    if (retryBtn) retryBtn.addEventListener('click', load);
    load();
  })();
</script>

<style>
  .portal-page { padding: 0; margin: 0; width: 100%; }
  .portal-entry-inner {
    width: 100%;
    max-width: 100%;
    padding: 2rem 1.5rem 3rem;
    margin: 0 auto;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .portal-entry-inner { padding: 2.5rem 2rem 4rem; }
  }
  .hub-chain-badge { display: inline-block; margin-bottom: 0.75rem; }
  .portal-entry .portal-hero { margin-bottom: 2.5rem; text-align: center; }
  .portal-hero-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent-teal);
    margin-bottom: 0.5rem;
    text-shadow: 0 0 10px rgba(59, 140, 255, 0.6);
  }
  .portal-hero-title .title-icon { color: var(--accent-teal); flex-shrink: 0; }
  .portal-hero .lead { color: var(--text-secondary); font-size: 1.05rem; margin-bottom: 1rem; max-width: 640px; margin-left: auto; margin-right: auto; }
  .portal-hero-lead { display: block; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; justify-content: center; }
  .hero-ctas .btn {
    padding: 0.6rem 1.2rem; font-size: 1rem; text-decoration: none; font-weight: 600; border-radius: 8px;
    display: inline-block; transition: all 0.2s ease; font-family: var(--font-display);
  }
  .hero-ctas .btn-primary { background: var(--accent-teal); color: var(--bg-primary); box-shadow: 0 0 20px rgba(59, 140, 255, 0.6); }
  .hero-ctas .btn-primary:hover { box-shadow: 0 0 30px rgba(59, 140, 255, 0.8); transform: translateY(-2px); }
  .hero-ctas .btn-secondary { background: transparent; color: #2563EB; border: 2px solid #2563EB; }
  .hero-ctas .btn-secondary:hover { background: #2563EB; color: #F0F4F8; }
  .hero-ctas .btn:focus-visible { outline: 2px solid var(--accent-teal); outline-offset: 2px; }

  .section { margin-top: 2.5rem; text-align: center; }
  .section h2 { font-size: 1.25rem; color: var(--text-primary); margin-bottom: 0.5rem; }
  .section p { color: var(--text-secondary); }
  .section .muted { max-width: 560px; margin-left: auto; margin-right: auto; }
  .muted { color: var(--text-tertiary); font-size: 0.95rem; margin-bottom: 1rem; }
  .muted a { color: var(--accent-teal); font-weight: 600; }

  .section-honesty {
    text-align: left;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 0.75rem;
    background: rgba(6, 182, 212, 0.05);
  }
  .section-honesty h2 { text-align: center; }
  .honesty-list { margin: 0.75rem 0 1rem 1.1rem; color: var(--text-secondary); }
  .honesty-list li { margin-bottom: 0.4rem; }
  .honesty-list code { font-size: 0.85em; }

  .role-cards, .eco-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
    text-align: left;
  }
  .role-card, .eco-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background: rgba(30, 41, 59, 0.35);
    border: 1px solid rgba(34, 211, 238, 0.2);
    border-radius: 1rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .role-card:hover, .eco-card:hover {
    border-color: rgba(34, 211, 238, 0.5);
    transform: translateY(-2px);
  }
  .role-card__icon { color: var(--accent-teal); margin-bottom: 0.5rem; }
  .role-card h3, .eco-card h3 { margin: 0 0 0.4rem; font-size: 1.1rem; color: var(--text-primary); }
  .role-card p, .eco-card p { margin: 0; font-size: 0.9rem; color: var(--text-secondary); flex: 1; }
  .role-card__cta { margin-top: 0.85rem; font-size: 0.85rem; color: var(--accent-teal); font-weight: 600; }

  .portal-hero.fade-in-up,
  .portal-hero .fade-in-up,
  .section.fade-in-up {
    animation: portal-fade-in-up var(--motion-sections-fade_in_duration, 0.6s) ease-out both;
  }
  .portal-hero .delay-1 { animation-delay: 0.08s; }
  .portal-hero .delay-2 { animation-delay: 0.16s; }
  @keyframes portal-fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .portal-hero.fade-in-up,
    .portal-hero .fade-in-up,
    .section.fade-in-up { animation: none; opacity: 1; transform: none; }
    .role-card:hover, .eco-card:hover { transform: none; }
  }
</style>
