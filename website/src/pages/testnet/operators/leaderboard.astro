---
import Layout from '../../../layouts/Layout.astro';
import IncentivizedTestnetNotice from '../../../components/IncentivizedTestnetNotice.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import HubNav from '../../../components/HubNav.astro';
import BoingLoader from '../../../components/BoingLoader.astro';
import { TESTNET_RPC_URL, BOOTNODES, isTestnetLive } from '../../../config/testnet';
import '../../../styles/hub-common.css';
---

<Layout
  title="Leaderboard — Operator Hub — Testnet Portal"
  description="Node operator leaderboard and metrics on Boing Network testnet."
>
  <article class="portal-page role-hub operators-hub hub-page hub-operator" data-hub="node_operator">
    <script is:inline src="/portal-session.js"></script>
    <Breadcrumbs items={[{ label: 'Testnet Portal', href: '/testnet' }, { label: 'Operator Hub', href: '/testnet/operators' }, { label: 'Leaderboard' }]} />
    <div class="hub-page-main">
    <HubNav hub="operator" current="leaderboard" />
    <IncentivizedTestnetNotice />
    <section class="section fade-in-up">
      <h1>Leaderboard</h1>
      <p class="muted">
        Validators ranked by <a href="/testnet/passport/leaderboard?track=node_operator">Testnet Passport</a> tier, then sampled uptime.
        The credibility indexer samples <code>boing_getValidators</code> every 10 minutes; averages build up over time.
        Blocks proposed = scheduled minus missed proposals in the current liveness window.
      </p>

      <div class="hub-metrics">
        <div class="hub-metric-card">
          <span class="value" id="leaderboard-operator-count">—</span>
          <span class="label">Operators</span>
        </div>
        <div class="hub-metric-card">
          <span class="value" id="leaderboard-total-blocks">—</span>
          <span class="label">Blocks (total)</span>
        </div>
        <div class="hub-metric-card">
          <span class="value" id="leaderboard-indexer-status">—</span>
          <span class="label">Indexer status</span>
        </div>
      </div>

      <div class="leaderboard-next-steps" id="leaderboard-next-steps" style="margin: 1.25rem 0 1.5rem;">
        <h2 style="font-size: 1.1rem; margin-bottom: 0.5rem;">What to do while ranking is empty</h2>
        <p class="muted" style="margin-bottom: 0.75rem;">Soak multi-node paths first. Portal registration is optional and not incentivized today.</p>
        <p>
          <a href="/testnet/join#run-a-node" class="btn btn-primary">RPC &amp; run a node</a>
          <a href="/testnet/operators/validator" class="btn btn-secondary">Validator guide</a>
          <a href="/faucet" class="btn btn-secondary">Faucet</a>
          <a href="/bootnodes" class="btn btn-secondary">Bootnodes</a>
          <a href="/testnet/register/operator" class="btn btn-secondary">Register (optional)</a>
        </p>
      </div>

      <table class="leaderboard-table hub-leaderboard-animate" aria-label="Operator leaderboard">
        <thead>
          <tr>
            <th>Rank</th>
            <th>Account</th>
            <th>Tier</th>
            <th>Status</th>
            <th>Blocks proposed</th>
            <th>Uptime (now)</th>
            <th>Uptime (avg, samples)</th>
          </tr>
        </thead>
        <tbody id="leaderboard-tbody">
          <tr id="leaderboard-placeholder-row">
            <td colspan="7" class="leaderboard-loading-cell">
              <BoingLoader block label="Loading leaderboard" />
            </td>
          </tr>
        </tbody>
      </table>
      <p class="leaderboard-placeholder-note" id="leaderboard-note">
        Empty table means no validators are registered yet. Sync steps and the official bootnode:
        <a href="/testnet/join#run-a-node">Join Testnet</a>.
      </p>
    </section>

    <section class="section fade-in-up delay-1">
      <h2>Your node</h2>
      <p>
        Peer with copy-paste steps on <a href="/testnet/join#run-a-node">Join Testnet</a>.
        To validate, <a href="/testnet/operators/validator">register your node</a> with a <strong>100 BOING</strong> bond
        (Express → Validate, or CLI) and keep it online. Running a testnet node is not incentivized today.
      </p>
      {isTestnetLive ? (
        <>
          <p><strong>RPC:</strong> <code>{TESTNET_RPC_URL}</code></p>
          {BOOTNODES.length > 0 && (
            <>
              <p><strong>Bootnodes:</strong></p>
              <pre class="code-block"><code>{BOOTNODES.join("\n")}</code></pre>
            </>
          )}
        </>
      ) : (
        <p>Testnet endpoints will appear here when live. Until then, use <a href="/single-vs-multi">local multi-node</a> or run with placeholder bootnodes.</p>
      )}
    </section>
  </div>
  </article>
</Layout>

<script is:inline src="/portal-session.js"></script>
<script>
  (function () {
    var expectedRole = 'node_operator';
    var session = window.BoingPortalSession && window.BoingPortalSession.getSession();
    var authEl = document.getElementById('portal-auth');
    if (session && !(window.BoingPortalSession && window.BoingPortalSession.hasTrack(session, expectedRole))) {
      var path = window.BoingPortalSession ? window.BoingPortalSession.roleAppPath(session.role) : '/testnet';
      window.location.href = path;
      return;
    }
    function renderAuth() {
      if (!authEl) return;
      if (!session) {
        authEl.innerHTML = '<a href="/testnet/sign-in" class="auth-link">Sign in</a>';
        return;
      }
      var short = window.BoingPortalSession ? window.BoingPortalSession.shortAccount(session.account_id_hex) : session.account_id_hex;
      authEl.innerHTML = 'Signed in as <span class="account-short">' + short + '</span> · <button type="button" id="portal-signout" class="auth-signout">Logout</button>';
      var so = document.getElementById('portal-signout');
      if (so) so.addEventListener('click', function () {
        if (window.BoingPortalSession && window.BoingPortalSession.logout) window.BoingPortalSession.logout();
        else { try { localStorage.removeItem('boing_portal_session'); } catch(_){} window.location.href = '/'; }
      });
    }
    renderAuth();

    function shortAccount(hex) {
      if (!hex || hex.length < 20) return hex || '';
      return hex.slice(0, 10) + '…' + hex.slice(-6);
    }

    function pct(v) { return (v == null || isNaN(Number(v))) ? '—' : Number(v).toFixed(1) + '%'; }
    function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); }
    function tierLabel(t) { return t && t !== 'none' ? t.charAt(0).toUpperCase() + t.slice(1) : '—'; }

    var tbody = document.getElementById('leaderboard-tbody');
    var placeholderRow = document.getElementById('leaderboard-placeholder-row');
    var operatorCountEl = document.getElementById('leaderboard-operator-count');
    var totalBlocksEl = document.getElementById('leaderboard-total-blocks');
    var indexerStatusEl = document.getElementById('leaderboard-indexer-status');
    var noteEl = document.getElementById('leaderboard-note');

    fetch('/api/portal/operator-leaderboard')
      .then(function (res) { return res.json().catch(function () { return {}; }); })
      .then(function (data) {
        if (!data.ok) {
          if (placeholderRow) placeholderRow.innerHTML = '<td colspan="7" style="text-align: center; color: var(--text-tertiary); padding: 2rem;">Unable to load leaderboard.</td>';
          return;
        }
        if (operatorCountEl) operatorCountEl.textContent = data.total_operators ?? 0;
        if (totalBlocksEl) totalBlocksEl.textContent = data.total_blocks ?? 0;
        if (indexerStatusEl) indexerStatusEl.textContent = data.indexer_last_tick ? 'Live' : 'Starting';

        var operators = data.operators || [];
        if (operators.length === 0) {
          if (placeholderRow) placeholderRow.innerHTML = '<td colspan="7" style="text-align: center; color: var(--text-tertiary); padding: 2rem;">No validators yet. Use the next steps above to run a peer or validator.</td>';
          return;
        }
        if (placeholderRow) placeholderRow.remove();
        var nextSteps = document.getElementById('leaderboard-next-steps');
        if (nextSteps) nextSteps.style.display = 'none';
        operators.forEach(function (op) {
          var tr = document.createElement('tr');
          tr.className = 'hub-leaderboard-row';
          if (op.tier === 'gold' || op.tier === 'silver' || op.tier === 'bronze') tr.classList.add('hub-leaderboard-row--' + op.tier);
          tr.innerHTML =
            '<td>' + op.rank + '</td>' +
            '<td><code class="account-short" title="validator ' + esc(op.id_short) + ' · owner ' + esc(op.owner_short) + '">' + esc(op.id_short) + '</code>' + (op.kind === 'anchor' ? ' <small class="muted">anchor</small>' : '') + '</td>' +
            '<td>' + tierLabel(op.tier) + '</td>' +
            '<td>' + esc(op.status || (op.in_set ? 'active' : '—')) + '</td>' +
            '<td>' + (op.blocks_proposed == null ? '—' : op.blocks_proposed) + '</td>' +
            '<td>' + pct(op.uptime_pct) + '</td>' +
            '<td>' + pct(op.avg_uptime) + ' <small class="muted">(' + (op.samples || 0) + ')</small></td>';
          if (tbody) tbody.appendChild(tr);
        });
        if (noteEl) noteEl.style.display = 'none';
      })
      .catch(function () {
        if (placeholderRow) placeholderRow.innerHTML = '<td colspan="7" style="text-align: center; color: var(--text-tertiary); padding: 2rem;">Could not load leaderboard. Practice with Join → run a node and the validator guide meanwhile.</td>';
      });
  })();
</script>
