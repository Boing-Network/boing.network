---
import Layout from '../../../layouts/Layout.astro';
import IncentivizedTestnetNotice from '../../../components/IncentivizedTestnetNotice.astro';
import HubNav from '../../../components/HubNav.astro';
import '../../../styles/hub-common.css';
---

<Layout
  title="Operator Hub — Testnet Portal"
  description="Boing Network testnet: run a validator and view the operator leaderboard."
>
  <article class="portal-page role-hub operators-hub hub-page hub-operator" data-hub="node_operator">
    <script is:inline src="/portal-session.js"></script>
    <div class="hub-page-main">
    <HubNav hub="operator" current="index" />
    <IncentivizedTestnetNotice />
    <div class="hub-hero fade-in-up">
      <h1>Operator Hub</h1>
      <p class="lead">
        Run a <strong>peer node</strong> or <strong>validator</strong> on public testnet <strong>6913</strong>.
        This hub is for <strong>node operators</strong> only.
        Day-to-day public RPC still rides a <strong>single hosted validator</strong> (<code>boing-testnet-1</code>) — peering helps soak multi-node paths.
        Running a testnet node is <strong>not incentivized</strong> today (not a mainnet claim).
        Start at <a href="/testnet/join#run-a-node">Join → run a node</a>, then the <a href="/testnet/operators/validator">validator guide</a>.
        Framing: <a href="/pdfs/BOING-TOKENOMICS-AND-INCENTIVIZED-TESTNET.pdf" target="_blank" rel="noopener">Tokenomics &amp; testnet (PDF)</a>.
      </p>
      <div class="hub-ctas" id="hub-ctas">
        <a href="/testnet/join#run-a-node" class="btn btn-primary">RPC &amp; run a node</a>
        <a href="/testnet/operators/validator" class="btn btn-secondary">Validator guide</a>
        <a href="/faucet" class="btn btn-secondary">Get faucet BOING</a>
        <a href="/bootnodes" class="btn btn-secondary">Bootnodes</a>
        <a href="/testnet/register/operator" class="btn btn-secondary">Register (optional)</a>
        <a href="/testnet/sign-in" class="btn btn-secondary">Sign in</a>
      </div>
    </div>

    <section class="section hub-glance-section fade-in-up delay-1" aria-label="Hub at a glance">
      <h2>Hub at a glance</h2>
      <div class="testnet-glance" id="operators-hub-glance">
        <div class="testnet-glance__card">
          <span class="testnet-glance__value" id="operator-glance-count">—</span>
          <span class="testnet-glance__label">Operators registered</span>
        </div>
      </div>
      <div class="hub-dapp-strip hub-dapp-strip--deco" id="operator-hub-strip" aria-hidden="true"></div>
    </section>

    <section class="section steps-section fade-in-up delay-1">
      <h2>Your journey</h2>
      <ol class="steps-list steps-list--numbered">
        <li><strong>Get testnet BOING</strong> — Use the <a href="/faucet">faucet</a> (about 100+ BOING for a validator bond plus fees).</li>
        <li><strong>Run a peer node</strong> — Download <code>testnet-v0.1.24</code> (or newer), dial the official bootnode, sync. Copy-paste: <a href="/testnet/join#run-a-node">Join Testnet</a>.</li>
        <li><strong>Optional: validate</strong> — Bond <strong>100 BOING</strong> from Express → Validate (or CLI). Full steps: <a href="/testnet/operators/validator">Run a validator</a>. Not incentivized today.</li>
        <li><strong>Optional: portal register</strong> — Add your account (and optional node address) on <a href="/testnet/register/operator">operator registration</a> so you can be counted when the indexer is live.</li>
        <li><strong>Leaderboard</strong> — The <a href="/testnet/operators/leaderboard">Leaderboard</a> stays empty until the operator indexer ships; practice by running a peer/validator first.</li>
      </ol>
    </section>

    <section class="section fade-in-up delay-2">
      <h2>Quick links</h2>
      <p><a href="/testnet/operators/dashboard" class="btn btn-secondary">My Dashboard</a> · <a href="/testnet/operators/leaderboard" class="btn btn-secondary">Leaderboard</a> · <a href="/testnet/operators/resources" class="btn btn-secondary">Resources</a> · <a href="/faucet">Faucet</a></p>
    </section>
    </div>
  </article>
</Layout>

<script is:inline src="/portal-session.js"></script>
<script>
  (function () {
    var expectedRole = 'node_operator';
    var session = window.BoingPortalSession && window.BoingPortalSession.getSession();
    var authEl = document.getElementById('portal-auth');
    var hubCtas = document.getElementById('hub-ctas');
    if (session && !(window.BoingPortalSession && window.BoingPortalSession.hasTrack(session, expectedRole))) {
      var path = window.BoingPortalSession ? window.BoingPortalSession.roleAppPath(session.role) : '/testnet';
      window.location.href = path;
      return;
    }
    function renderAuth() {
      if (!authEl) return;
      if (!session) {
        authEl.innerHTML = '<a href="/testnet/sign-in" class="auth-link">Sign in</a>';
        return;
      }
      var short = window.BoingPortalSession ? window.BoingPortalSession.shortAccount(session.account_id_hex) : session.account_id_hex;
      authEl.innerHTML = 'Signed in as <span class="account-short">' + short + '</span> · <button type="button" id="portal-signout" class="auth-signout">Logout</button>';
      if (hubCtas) hubCtas.style.display = 'none';
      var so = document.getElementById('portal-signout');
      if (so) so.addEventListener('click', function () {
        if (window.BoingPortalSession && window.BoingPortalSession.logout) window.BoingPortalSession.logout();
        else { try { localStorage.removeItem('boing_portal_session'); } catch(_){} window.location.href = '/'; }
      });
    }
    renderAuth();

    var countEl = document.getElementById('operator-glance-count');
    var stripEl = document.getElementById('operator-hub-strip');
    fetch('/api/portal/operator-leaderboard').then(function (r) { return r.json().catch(function () { return {}; }); }).then(function (data) {
      var n = (data.ok && data.total_operators != null) ? data.total_operators : 0;
      if (countEl) countEl.textContent = n;
      if (stripEl) {
        var k = n > 0 ? Math.min(n, 6) : 4;
        for (var i = 0; i < k; i++) {
          var pill = document.createElement('span');
          pill.className = 'hub-dapp-strip__pill';
          stripEl.appendChild(pill);
        }
      }
    }).catch(function () {});
  })();
</script>
