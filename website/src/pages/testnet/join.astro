---
import ChainIdleNotice from '../../components/ChainIdleNotice.astro';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CopyButton from '../../components/CopyButton.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import IncentivizedTestnetNotice from '../../components/IncentivizedTestnetNotice.astro';
import {
  TESTNET_RPC_URL,
  BOOTNODES,
  BOOTNODES_CSV,
  isTestnetLive,
  TESTNET_CHAIN_ID,
  TESTNET_NODE_RELEASE,
  RECOMMENDED_WALLET_VERSION,
  RECOMMENDED_SDK_VERSION,
  ECOSYSTEM,
  HOSTED_TESTNET_NATIVE_DEX_PUBLISHED,
  CANONICAL_NATIVE_CP_POOL_ACCOUNT_ID_HEX,
  CANONICAL_NATIVE_AMM_LP_VAULT_ACCOUNT_ID_HEX,
  CANONICAL_NATIVE_LP_SHARE_TOKEN_ACCOUNT_ID_HEX,
  CANONICAL_LINKED_NFT_TOKEN_REGISTRY_ACCOUNT_ID_HEX,
  CANONICAL_BUILDER_ATTESTATION_REGISTRY_ACCOUNT_ID_HEX,
} from '../../config/testnet';

const relUrl = `https://github.com/Boing-Network/boing.network/releases/tag/${TESTNET_NODE_RELEASE}`;
const linuxZip = `https://github.com/Boing-Network/boing.network/releases/download/${TESTNET_NODE_RELEASE}/release-linux-x86_64.zip`;

const getBinary = `curl -sSLO ${linuxZip}
unzip release-linux-x86_64.zip
mv boing-node-linux-x86_64 boing-node
mv boing-linux-x86_64 boing
chmod +x boing-node boing`;

const runPeer = `export BOING_CHAIN_ID=${TESTNET_CHAIN_ID}
./boing-node \\
  --data-dir ./boing-data \\
  --p2p-listen /ip4/0.0.0.0/tcp/4001 \\
  --bootnodes ${BOOTNODES_CSV} \\
  --rpc-port 8545`;

const checkSync = `curl -s -X POST http://127.0.0.1:8545 -H 'content-type: application/json' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"boing_health","params":[]}'
# Compare head_height with the public RPC at ${TESTNET_RPC_URL}`;
---

<Layout
  title="Join Testnet"
  description="Boing Network public testnet 6913: endpoints, run a node, bootnodes, faucet, Express / Finance / Observer."
>
  <article class="page-wrap-full">
    <header class="page-hero-full">
      <div class="page-wrap-inner">
        <span class="stage-badge-global">Public testnet · chain {TESTNET_CHAIN_ID}</span>
        <h1 class="page-title"><Icon name="network" size={32} class="title-icon" /> Join the Testnet</h1>
        <p class="lead">
          Connect to live chain <strong>{TESTNET_CHAIN_ID}</strong>: use the apps, run a peer node, or register as a validator.
          Day-to-day hosted traffic still uses a <strong>single validator path</strong> (not multi-region HA).
          Incentivized rewards are <strong>not</strong> running.
        </p>
      </div>
    </header>
    <div class="page-wrap-inner testnet-content">
    <ChainIdleNotice />
    <IncentivizedTestnetNotice />

    <section class="section" id="at-a-glance">
      <h2><Icon name="network" size={22} class="section-icon" /> At a glance</h2>
      {isTestnetLive ? (
        <dl class="glance-grid">
          <div class="glance-item">
            <dt>RPC</dt>
            <dd>
              <div class="copy-wrapper rpc-copy" data-copy-value={TESTNET_RPC_URL}>
                <code class="rpc-url-display">{TESTNET_RPC_URL}</code>
                <CopyButton label="Copy" copiedLabel="Copied!" />
              </div>
            </dd>
          </div>
          <div class="glance-item">
            <dt>Bootnode</dt>
            <dd>
              {BOOTNODES.map((bn) => (
                <div class="copy-wrapper rpc-copy" data-copy-value={bn}>
                  <code class="rpc-url-display">{bn}</code>
                  <CopyButton label="Copy" copiedLabel="Copied!" />
                </div>
              ))}
            </dd>
          </div>
          <div class="glance-item">
            <dt>Node release</dt>
            <dd><a href={relUrl} target="_blank" rel="noopener"><code>{TESTNET_NODE_RELEASE}</code></a> (or newer)</dd>
          </div>
          <div class="glance-item">
            <dt>Wallet / SDK</dt>
            <dd>
              Express <strong>{RECOMMENDED_WALLET_VERSION}</strong> ·
              <code>@boing-network/boing-sdk@^{RECOMMENDED_SDK_VERSION}</code>
            </dd>
          </div>
        </dl>
      ) : (
        <p>Endpoints appear here when the public testnet is configured.</p>
      )}
      <p class="muted small-print">
        Official listing JSON: <a href="/api/networks">/api/networks</a>.
        Only <strong>one</strong> hosted bootnode — the old companion IP was retired.
      </p>
    </section>

    <section class="section" id="paths">
      <h2>Choose a path</h2>
      <div class="dedicated-cards">
        <a href="#use-apps" class="dedicated-card card-reveal">
          <span class="card-icon"><Icon name="quest" size={28} /></span>
          <h2>Use the apps</h2>
          <p>Express wallet, Finance DEX, Observer explorer, faucet.</p>
          <span class="card-arrow">Skip to apps →</span>
        </a>
        <a href="#run-a-node" class="dedicated-card featured card-reveal">
          <span class="card-icon"><Icon name="node" size={28} /></span>
          <h2>Run a peer node</h2>
          <p>Download the binary, dial the bootnode, sync. Copy-paste steps below.</p>
          <span class="card-arrow">Step-by-step →</span>
        </a>
        <a href="/testnet/operators/validator" class="dedicated-card featured card-reveal">
          <span class="card-icon"><Icon name="node" size={28} /></span>
          <h2>Become a validator</h2>
          <p>After syncing: 100 BOING bond via Express Validate (or CLI).</p>
          <span class="card-arrow">Full guide →</span>
        </a>
        <a href="/bootnodes" class="dedicated-card card-reveal">
          <span class="card-icon"><Icon name="network" size={28} /></span>
          <h2>Bootnodes</h2>
          <p>What they are and the official address to copy.</p>
          <span class="card-arrow">Read more →</span>
        </a>
        <a href="/single-vs-multi" class="dedicated-card card-reveal">
          <span class="card-icon"><Icon name="node" size={28} /></span>
          <h2>Local vs public</h2>
          <p>When to run alone on your laptop vs joining the live network.</p>
          <span class="card-arrow">Compare →</span>
        </a>
        <a href="/testnet" class="dedicated-card card-reveal">
          <span class="card-icon"><Icon name="portal" size={28} /></span>
          <h2>Testnet Hub</h2>
          <p>Register as user, developer, or operator.</p>
          <span class="card-arrow">Open portal →</span>
        </a>
      </div>
    </section>

    <section class="section" id="run-a-node">
      <h2><Icon name="rocket" size={22} class="section-icon" /> Run a peer node (step by step)</h2>
      <p class="muted">
        Goal: your machine syncs chain {TESTNET_CHAIN_ID} from the hosted bootnode.
        You are <strong>not</strong> a validator yet — that is a separate registration step.
      </p>
      <ol class="steps-plain">
        <li>
          <strong>Get the binary</strong> — download
          <a href={relUrl} target="_blank" rel="noopener">{TESTNET_NODE_RELEASE}</a>
          (Linux example; Windows and macOS zips are on the same release page). Rename the platform binaries:
          <CodeBlock code={getBinary} label="Download Linux node binary" />
          Prefer building from source? <code>cargo build --release -p boing-node -p boing-cli</code> — details in the
          <a href="/testnet/operators/validator#node">validator guide</a>.
        </li>
        <li>
          <strong>Start the node</strong> — listen for peers and dial the official bootnode:
          <CodeBlock code={runPeer} label="Join as a peer" />
          Open inbound <strong>TCP 4001</strong> in your firewall if you want others to connect to you.
          Keep RPC on localhost unless you intend to serve public JSON-RPC.
        </li>
        <li>
          <strong>Confirm sync</strong> — your <code>head_height</code> should track the public RPC:
          <CodeBlock code={checkSync} label="Check local sync" />
        </li>
        <li>
          <strong>Optional: validate</strong> — fund ~100+ BOING from the <a href="/faucet">faucet</a>, then follow
          <a href="/testnet/operators/validator">Run a validator</a> (Express <strong>Validate</strong> tab or
          <code>boing validator register</code>).
        </li>
      </ol>
      <p class="muted small-print">
        Deeper ops: <a href="/pdfs/RUNBOOK.pdf" target="_blank" rel="noopener">RUNBOOK (PDF)</a> ·
        <a href="https://github.com/Boing-Network/boing.network/blob/main/docs/TESTNET-VALIDATOR-GUIDE.md" target="_blank" rel="noopener">TESTNET-VALIDATOR-GUIDE.md</a> ·
        <a href="https://github.com/Boing-Network/boing.network/blob/main/docs/NODE-OPERATOR-COMMANDS.md" target="_blank" rel="noopener">NODE-OPERATOR-COMMANDS.md</a>.
      </p>
    </section>

    <section class="section" id="bootnodes">
      <h2>Bootnodes</h2>
      <p>
        Bootnodes are the first peers your node dials. Public testnet currently publishes
        <strong> one</strong> hosted address (Fly <code>boing-testnet-1</code>).
        Full plain-language guide: <a href="/bootnodes">Bootnodes</a>.
      </p>
      {isTestnetLive && BOOTNODES.length > 0 && (
        <pre class="code-block"><code>{BOOTNODES.join('\n')}</code></pre>
      )}
    </section>

    <section class="section" id="use-apps">
      <h2>Apps on this testnet</h2>
      <p class="muted">Same chain {TESTNET_CHAIN_ID}. Activity may count toward your Testnet Passport — not a promise of tokens.</p>
      <div class="eco-cards">
        <a href={ECOSYSTEM.express} target="_blank" rel="noopener" class="eco-card">
          <h3>Express</h3>
          <p>Wallet — recommended {RECOMMENDED_WALLET_VERSION}. Create an account, Validate tab for bonding.</p>
        </a>
        <a href={ECOSYSTEM.finance} target="_blank" rel="noopener" class="eco-card">
          <h3>Finance</h3>
          <p>Native DEX — swaps, pools, NFTs against the public RPC.</p>
        </a>
        <a href={ECOSYSTEM.observer} target="_blank" rel="noopener" class="eco-card">
          <h3>Observer</h3>
          <p>Explorer — blocks, accounts, and QA visibility.</p>
        </a>
        <a href="/faucet" class="eco-card">
          <h3>Faucet</h3>
          <p>Free testnet BOING for fees and the 100 BOING validator bond.</p>
        </a>
      </div>
      <p class="muted small-print">
        Developers: install <code>@boing-network/boing-sdk@^{RECOMMENDED_SDK_VERSION}</code> (scoped package name).
        Hub quests: <a href="/testnet/users">Community users</a> · <a href="/testnet/developers">Developers</a>.
      </p>
    </section>

    <section class="section section-honesty" id="honest-limits">
      <h2>Honest limits</h2>
      <ul>
        <li><strong>Testnet only</strong> — mainnet (6914) is not live; no TGE date here.</li>
        <li><strong>Single hosted validator path</strong> for day-to-day public traffic (<code>boing-testnet-1</code>); not multi-region HA.</li>
        <li><strong>One official bootnode</strong> — do not use the retired <code>boing-testnet-2</code> address.</li>
        <li><strong>No incentivized rewards</strong> until rules are published and marked live.</li>
        <li><strong>Testnet BOING</strong> has no cash value; the chain may reset.</li>
        <li><strong>Blocks idle</strong> when there are no transactions — a faucet request produces a block.</li>
      </ul>
    </section>

    <section class="section" id="node-listing">
      <h2>Prebuilt packages</h2>
      <p>
        <a href="/api/networks">/api/networks</a> lists Windows, Linux, and macOS downloads plus a ready
        <code>node_command_template</code> (includes open-validator consensus flags for fresh sync).
      </p>
      <p class="muted networks-api-line" id="networks-api-status" aria-live="polite">Checking network listing…</p>
    </section>

    <details class="section integrator-details" id="integrator-ids">
      <summary>Integrator contract ids (DEX, registries)</summary>
      <div class="integrator-body">
        <p class="muted">
          For app builders. Live truth is still <code>boing_getNetworkInfo.end_user</code> on the public RPC.
        </p>
        {HOSTED_TESTNET_NATIVE_DEX_PUBLISHED ? (
          <>
            <p><strong>Canonical CP pool</strong></p>
            <div class="copy-wrapper rpc-copy" data-copy-value={CANONICAL_NATIVE_CP_POOL_ACCOUNT_ID_HEX}>
              <code class="rpc-url-display pool-id-display">{CANONICAL_NATIVE_CP_POOL_ACCOUNT_ID_HEX}</code>
              <CopyButton label="Copy" copiedLabel="Copied!" />
            </div>
            <p><strong>LP vault</strong></p>
            <div class="copy-wrapper rpc-copy" data-copy-value={CANONICAL_NATIVE_AMM_LP_VAULT_ACCOUNT_ID_HEX}>
              <code class="rpc-url-display pool-id-display">{CANONICAL_NATIVE_AMM_LP_VAULT_ACCOUNT_ID_HEX}</code>
              <CopyButton label="Copy" copiedLabel="Copied!" />
            </div>
            <p><strong>LP share token</strong></p>
            <div class="copy-wrapper rpc-copy" data-copy-value={CANONICAL_NATIVE_LP_SHARE_TOKEN_ACCOUNT_ID_HEX}>
              <code class="rpc-url-display pool-id-display">{CANONICAL_NATIVE_LP_SHARE_TOKEN_ACCOUNT_ID_HEX}</code>
              <CopyButton label="Copy" copiedLabel="Copied!" />
            </div>
          </>
        ) : (
          <p>Canonical native DEX ids are not published on the hosted RPC yet.</p>
        )}
        <p><strong>Linked NFT ↔ token registry</strong></p>
        <div class="copy-wrapper rpc-copy" data-copy-value={CANONICAL_LINKED_NFT_TOKEN_REGISTRY_ACCOUNT_ID_HEX}>
          <code class="rpc-url-display pool-id-display">{CANONICAL_LINKED_NFT_TOKEN_REGISTRY_ACCOUNT_ID_HEX}</code>
          <CopyButton label="Copy" copiedLabel="Copied!" />
        </div>
        <p><strong>Builder attestation registry</strong></p>
        <div class="copy-wrapper rpc-copy" data-copy-value={CANONICAL_BUILDER_ATTESTATION_REGISTRY_ACCOUNT_ID_HEX}>
          <code class="rpc-url-display pool-id-display">{CANONICAL_BUILDER_ATTESTATION_REGISTRY_ACCOUNT_ID_HEX}</code>
          <CopyButton label="Copy" copiedLabel="Copied!" />
        </div>
        <p class="muted small-print">
          Specs:
          <a href="https://github.com/Boing-Network/boing.network/blob/main/docs/RPC-API-SPEC.md" target="_blank" rel="noopener">RPC-API-SPEC</a> ·
          <a href="/pdfs/RPC-API-SPEC.pdf" target="_blank" rel="noopener">PDF</a>
        </p>
      </div>
    </details>

    <section class="section">
      <h2>Docs</h2>
      <ul class="docs-quick-links">
        <li><a href="/docs/getting-started">Getting started</a></li>
        <li><a href="/pdfs/TESTNET.pdf" target="_blank" rel="noopener">TESTNET (PDF)</a> — Full testnet guide</li>
        <li><a href="/pdfs/BOING-TOKENOMICS-AND-INCENTIVIZED-TESTNET.pdf" target="_blank" rel="noopener">Tokenomics &amp; incentivized testnet (PDF)</a></li>
        <li><a href="/pdfs/RUNBOOK.pdf" target="_blank" rel="noopener">RUNBOOK (PDF)</a> — Node setup and RPC</li>
        <li><a href="/testnet/operators">Operator Hub</a> · <a href="/testnet/users">User Hub</a> · <a href="/testnet/developers">Developer Hub</a></li>
      </ul>
    </section>
    </div>
  </article>
</Layout>

<style>
  .testnet-content { padding-bottom: 3rem; }
  .page-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  .title-icon { color: var(--accent-teal); flex-shrink: 0; }
  .lead { color: var(--text-secondary); font-size: 1.1rem; }
  .dedicated-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin: 1.25rem 0 0; }
  .dedicated-card {
    animation: card-reveal 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  .dedicated-card:nth-child(1) { animation-delay: 0.05s; }
  .dedicated-card:nth-child(2) { animation-delay: 0.12s; }
  .dedicated-card:nth-child(3) { animation-delay: 0.19s; }
  .dedicated-card:nth-child(4) { animation-delay: 0.26s; }
  .dedicated-card:nth-child(5) { animation-delay: 0.33s; }
  .dedicated-card:nth-child(6) { animation-delay: 0.4s; }
  @keyframes card-reveal { to { opacity: 1; transform: translateY(0); } }
  .dedicated-card:hover .card-icon { transform: scale(1.08); }
  .card-icon {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--accent-teal);
    transition: transform 0.25s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .dedicated-card { animation: none; opacity: 1; transform: none; }
    .dedicated-card:hover .card-icon { transform: none; }
  }
  .dedicated-card {
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 1.25rem;
    background: rgba(30,41,59,0.35);
    border: 1px solid rgba(34,211,238,0.2);
    border-radius: 1rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .dedicated-card:hover { border-color: rgba(34,211,238,0.5); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(6,182,212,0.2); }
  .dedicated-card.featured { border-color: rgba(34,211,238,0.4); background: rgba(6,182,212,0.06); }
  .dedicated-card h2 { font-size: 1.1rem; margin: 0 0 0.5rem; color: var(--text-primary); }
  .dedicated-card p { font-size: 0.9rem; color: var(--text-secondary); margin: 0; line-height: 1.4; flex: 1; min-height: 0; }
  .card-arrow {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--accent-teal);
    font-weight: 500;
  }
  .section-icon { vertical-align: middle; margin-right: 0.35rem; color: var(--accent-teal); }
  .section { margin-top: 2rem; }
  .section h2 {
    display: flex;
    align-items: center;
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  .section p, .section li { color: var(--text-secondary); }
  .section code { background: rgba(255,255,255,0.08); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
  .steps-plain { margin: 0.75rem 0 0 1.2rem; }
  .steps-plain > li { margin-bottom: 1.1rem; }
  .docs-quick-links { list-style: none; padding-left: 0; }
  .docs-quick-links li { margin-bottom: 0.5rem; }
  .docs-quick-links a { color: var(--accent-teal); font-weight: 500; }
  .code-block { background: rgba(0,0,0,0.3); border: 1px solid rgba(34,211,238,0.2); border-radius: 8px; padding: 1rem; overflow-x: auto; font-size: 0.85rem; }
  .code-block code { background: none; padding: 0; }
  @media (prefers-reduced-motion: reduce) { .dedicated-card:hover { transform: none; } }
  .rpc-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }
  .rpc-copy .rpc-url-display {
    font-size: 0.9rem;
    padding: 0.35rem 0.5rem;
    background: rgba(0,0,0,0.25);
    border-radius: 6px;
  }
  .rpc-copy .pool-id-display {
    word-break: break-all;
    max-width: min(100%, 42rem);
  }
  .small-print { font-size: 0.85rem; margin-top: 0.5rem; }
  .muted { color: var(--text-tertiary); }
  .glance-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin: 0.75rem 0;
  }
  .glance-item {
    margin: 0;
    padding: 0.85rem 1rem;
    background: rgba(30,41,59,0.35);
    border: 1px solid rgba(34,211,238,0.2);
    border-radius: 0.75rem;
  }
  .glance-item dt {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-tertiary);
    margin-bottom: 0.35rem;
  }
  .glance-item dd { margin: 0; color: var(--text-secondary); }
  .eco-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .eco-card {
    display: flex;
    flex-direction: column;
    padding: 1.1rem;
    background: rgba(30, 41, 59, 0.35);
    border: 1px solid rgba(34, 211, 238, 0.2);
    border-radius: 1rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .eco-card:hover { border-color: rgba(34, 211, 238, 0.5); transform: translateY(-2px); }
  .eco-card h3 { margin: 0 0 0.4rem; font-size: 1.05rem; color: var(--text-primary); }
  .eco-card p { margin: 0; font-size: 0.9rem; color: var(--text-secondary); }
  .section-honesty {
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 0.75rem;
    background: rgba(6, 182, 212, 0.05);
  }
  .section-honesty ul { margin: 0.5rem 0 0 1.1rem; }
  .integrator-details {
    border: 1px solid rgba(34,211,238,0.2);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem 1rem;
    background: rgba(30,41,59,0.25);
  }
  .integrator-details summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-primary);
    list-style: none;
  }
  .integrator-details summary::-webkit-details-marker { display: none; }
  .integrator-details summary::before {
    content: '▸ ';
    color: var(--accent-teal);
  }
  .integrator-details[open] summary::before { content: '▾ '; }
  .integrator-body { margin-top: 0.85rem; }
  .integrator-body p { margin: 0.65rem 0 0.25rem; }
  @media (max-width: 640px) {
    .testnet-content { padding-bottom: 2rem; }
    .dedicated-cards { margin-top: 1rem; gap: 0.75rem; }
    .dedicated-card { padding: 1rem; }
    .section { margin-top: 1.5rem; }
    .eco-card:hover { transform: none; }
  }
  .networks-api-line { font-size: 0.9rem; margin-top: 0.75rem; }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('networks-api-status');
    if (!el) return;
    fetch('/api/networks', { credentials: 'omit' })
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        if (!data || !data.ok || !Array.isArray(data.networks)) {
          el.textContent = 'Could not read /api/networks.';
          return;
        }
        if (data.warning) {
          el.textContent = data.warning;
          return;
        }
        var want = ['boing-devnet', 'boing-devnet-linux', 'boing-devnet-macos'];
        var ready = [];
        var missing = [];
        want.forEach(function (id) {
          var n = data.networks.filter(function (x) {
            return x && x.id === id;
          })[0];
          if (!n) {
            missing.push(id);
            return;
          }
          if (n.node_download_url && n.node_command_template) ready.push(id);
          else missing.push(id);
        });
        var tag = data.meta && data.meta.boing_testnet_download_tag;
        var tagNote = tag ? ' Release tag: ' + tag + '.' : '';
        if (missing.length === 0) {
          el.textContent =
            'Listings active: Windows, Linux, and macOS packages are configured.' + tagNote;
        } else if (ready.length > 0) {
          el.textContent =
            'Partial: ' +
            ready.length +
            ' of 3 platform listings have download URL + command. Missing or incomplete: ' +
            missing.join(', ') +
            '.' +
            tagNote;
        } else {
          el.textContent =
            'Devnet entries exist but D1 has not set node_download_url / node_command_template yet (see website migrations).';
        }
      })
      .catch(function () {
        el.textContent = 'Could not load /api/networks.';
      });
  })();
</script>
