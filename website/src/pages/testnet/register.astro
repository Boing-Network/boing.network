---
import Layout from '../../layouts/Layout.astro';
import IncentivizedTestnetNotice from '../../components/IncentivizedTestnetNotice.astro';
---

<Layout
  title="Register — Testnet Portal"
  description="Choose your role: developer, user, or node operator. Register for the Boing Network testnet."
>
  <article class="portal-page choose-role-page page-wrap-full">
    <script is:inline src="/portal-session.js"></script>
    <script is:inline>
      (function(){
        try {
          var session = window.BoingPortalSession && window.BoingPortalSession.getSession();
          if (session && session.role) {
            var path = window.BoingPortalSession.roleAppPath(session.role);
            if (path) { window.location.href = path; return; }
          }
        } catch(e) {}
      })();
    </script>
    <header class="page-hero-full">
      <div class="page-wrap-inner register-hero-inner">
        <span class="stage-badge-global">Testnet</span>
        <p class="back-link"><a href="/testnet">← Dashboard</a> · <a href="/">Boing Network</a></p>
        <h1>Register for the testnet</h1>
        <p class="lead">
          Choose your role to open a registration form tailored to you. One account per role; you can update your role later.
        </p>
      </div>
    </header>
    <div class="page-wrap-inner register-content">
    <IncentivizedTestnetNotice />
      <div class="register-role-cards">
        <a href="/testnet/register/developer" class="role-option">
          <span class="role-title">Developer</span>
          <span class="role-desc">Build dApps and register contracts.</span>
          <span class="role-cta">Register as developer →</span>
        </a>
        <a href="/testnet/register/user" class="role-option">
          <span class="role-title">User</span>
          <span class="role-desc">Use the faucet, complete quests, share feedback.</span>
          <span class="role-cta">Register as user →</span>
        </a>
        <a href="/testnet/register/operator" class="role-option">
          <span class="role-title">Node operator / Miner</span>
          <span class="role-desc">Run a validator and appear on the operator leaderboard.</span>
          <span class="role-cta">Register as operator →</span>
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .portal-page { padding: 0; margin: 0; width: 100%; }
  .choose-role-page .register-hero-inner {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    padding: 2rem 2rem 1.5rem;
    box-sizing: border-box;
  }
  .choose-role-page .register-content {
    width: 100%;
    max-width: 100%;
    padding: 1rem 2rem 3rem;
    margin: 0 auto;
    box-sizing: border-box;
  }
  @media (max-width: 768px) {
    .choose-role-page .register-hero-inner { padding: 1.5rem 1.25rem 1rem; }
    .choose-role-page .register-content { padding: 1rem 1.25rem 3rem; }
  }
  .register-role-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  @media (max-width: 900px) {
    .register-role-cards { grid-template-columns: 1fr; max-width: 420px; margin-left: auto; margin-right: auto; }
  }
  .back-link { margin-bottom: 0.75rem; }
  .back-link a { color: var(--accent-teal); text-decoration: none; }
  .back-link a:hover { text-decoration: underline; }
  .page-hero-full .lead { color: var(--text-secondary); margin-bottom: 0; line-height: 1.5; }
  .choose-role-page .register-hero-inner h1 { margin: 0 0 0.5rem; }
  .role-option {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: rgba(30,41,59,0.35);
    border: 1px solid rgba(34,211,238,0.2);
    border-radius: 1rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .role-option:hover {
    border-color: rgba(34,211,238,0.5);
    box-shadow: 0 8px 24px rgba(6,182,212,0.2);
  }
  .role-title { font-size: 1.15rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.35rem; }
  .role-desc { font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 0.75rem; line-height: 1.4; }
  .role-cta { font-size: 0.9rem; color: var(--accent-teal); font-weight: 500; margin-top: auto; padding: 0.35rem 0 0; }
</style>
