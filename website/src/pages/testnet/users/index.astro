---
import Layout from '../../../layouts/Layout.astro';
import IncentivizedTestnetNotice from '../../../components/IncentivizedTestnetNotice.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import HubNav from '../../../components/HubNav.astro';
import '../../../styles/hub-common.css';
---

<Layout
  title="Community Hub — Testnet Portal"
  description="Boing Network testnet: user community, quests, faucet, and feedback."
>
  <article class="portal-page role-hub users-hub hub-page hub-community" data-hub="user">
    <script is:inline src="/portal-session.js"></script>
    <Breadcrumbs items={[{ label: 'Testnet Portal', href: '/testnet' }, { label: 'Community Hub' }]} />
    <div class="hub-page-main">
    <HubNav hub="user" current="index" />
    <IncentivizedTestnetNotice />
    <div class="hub-hero fade-in-up">
      <h1>Community Hub</h1>
      <p class="lead">
        Use the faucet, try <a href="https://boing.express" target="_blank" rel="noopener">Express</a>,
        <a href="https://boing.finance" target="_blank" rel="noopener">Finance</a>, and
        <a href="https://boing.observer" target="_blank" rel="noopener">Observer</a>, complete quests, and share feedback.
        This hub is for <strong>community users</strong>. Verified activity is recorded in your <strong>Testnet Passport</strong> and may be considered for any future program — it is not a promise of tokens, an airdrop, or a mainnet claim.
        Background: <a href="/pdfs/BOING-TOKENOMICS-AND-INCENTIVIZED-TESTNET.pdf" target="_blank" rel="noopener">Tokenomics &amp; testnet (PDF)</a>
        · <a href="/pdfs/TESTNET.pdf" target="_blank" rel="noopener">Testnet doc (PDF)</a>.
      </p>
      <div class="hub-ctas" id="hub-ctas">
        <a href="/faucet" class="btn btn-primary">Get faucet BOING</a>
        <a href="/testnet/users/quests" class="btn btn-secondary">Practice quests</a>
        <a href="https://boing.express" class="btn btn-secondary" target="_blank" rel="noopener">Open Express</a>
        <a href="https://boing.finance" class="btn btn-secondary" target="_blank" rel="noopener">Open Finance</a>
        <a href="https://boing.observer" class="btn btn-secondary" target="_blank" rel="noopener">Open Observer</a>
        <a href="/testnet/register/user" class="btn btn-secondary">Register (optional)</a>
        <a href="/testnet/sign-in" class="btn btn-secondary">Sign in</a>
      </div>
    </div>

    <section class="section hub-glance-section fade-in-up delay-1" aria-label="Hub at a glance">
      <h2>Hub at a glance</h2>
      <div class="testnet-glance" id="users-hub-glance">
        <div class="testnet-glance__card">
          <span class="testnet-glance__value" id="user-glance-quests">—</span>
          <span class="testnet-glance__label">Quest completions</span>
        </div>
      </div>
      <div class="testnet-progress-bar" role="presentation" aria-hidden="true" style="max-width: 320px; margin: 1rem auto;"><div class="testnet-progress-bar__fill" id="user-glance-progress" style="--progress: 0;"></div></div>
    </section>

    <section class="section steps-section fade-in-up delay-1">
      <h2>Your journey</h2>
      <ol class="steps-list steps-list--numbered">
        <li><strong>Get testnet BOING</strong> — Use the <a href="/faucet">faucet</a> (one request per account per 60 seconds).</li>
        <li><strong>Practice the apps</strong> — Try <a href="https://boing.express" target="_blank" rel="noopener">Express</a>, <a href="https://boing.finance" target="_blank" rel="noopener">Finance</a> (Swap, Pools, Portfolio, Bridge), and <a href="https://boing.observer" target="_blank" rel="noopener">Observer</a>. Finance swaps and liquidity auto-verify as a quest.</li>
        <li><strong>Complete quests</strong> — Faucet, first tx, Express / Finance / Observer tasks, feedback, community. See the <a href="/testnet/users/quests">Quests</a> page.</li>
        <li><strong>Submit completions</strong> — Sign in as a registered user and use the form on the Quests page. Need help or an outage? <a href="https://discord.gg/K3w9nbUw4N" target="_blank" rel="noopener">Discord #testnet</a>.</li>
        <li><strong>Optional: register</strong> — Add your account on the <a href="/testnet/register/user">user registration</a> page to track progress. Registration does not unlock incentives today.</li>
      </ol>
    </section>

    <section class="section fade-in-up delay-2">
      <h2>Quick links</h2>
      <p><a href="/testnet/users/dashboard" class="btn btn-secondary">My Dashboard</a> · <a href="/testnet/users/community" class="btn btn-secondary">Community</a> · <a href="/testnet/users/quests" class="btn btn-secondary">Quests</a> · <a href="/faucet">Faucet</a> · <a href="/testnet/join">Join Testnet</a></p>
    </section>
    </div>
  </article>
</Layout>

<script is:inline src="/portal-session.js"></script>
<script define:vars={{ expectedRole: 'user' }}>
  (function () {
    var session = window.BoingPortalSession && window.BoingPortalSession.getSession();
    var authEl = document.getElementById('portal-auth');
    var hubCtas = document.getElementById('hub-ctas');
    if (session && !(window.BoingPortalSession && window.BoingPortalSession.hasTrack(session, expectedRole))) {
      var path = window.BoingPortalSession ? window.BoingPortalSession.roleAppPath(session.role) : '/testnet';
      window.location.href = path;
      return;
    }
    function renderAuth() {
      if (!authEl) return;
      if (!session) {
        authEl.innerHTML = '<a href="/testnet/sign-in" class="auth-link">Sign in</a>';
        return;
      }
      var short = window.BoingPortalSession ? window.BoingPortalSession.shortAccount(session.account_id_hex) : session.account_id_hex;
      authEl.innerHTML = 'Signed in as <span class="account-short">' + short + '</span> · <button type="button" id="portal-signout" class="auth-signout">Logout</button>';
      if (hubCtas) hubCtas.style.display = 'none';
      var so = document.getElementById('portal-signout');
      if (so) so.addEventListener('click', function () {
        if (window.BoingPortalSession && window.BoingPortalSession.logout) window.BoingPortalSession.logout();
        else { try { localStorage.removeItem('boing_portal_session'); } catch(_){} window.location.href = '/'; }
      });
    }
    renderAuth();

    var glanceEl = document.getElementById('user-glance-quests');
    var progressEl = document.getElementById('user-glance-progress');
    fetch('/api/portal/quests-stats').then(function (r) { return r.json().catch(function () { return {}; }); }).then(function (data) {
      var total = (data.ok && data.total_completions != null) ? data.total_completions : 0;
      if (glanceEl) glanceEl.textContent = total;
      if (progressEl) progressEl.style.setProperty('--progress', Math.min(100, total * 2));
    }).catch(function () {});
  })();
</script>
