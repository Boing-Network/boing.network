---
import Layout from '../layouts/Layout.astro';
import { TESTNET_RPC_URL } from '../config/testnet';
---

<Layout title="Network Status" description="Boing Network testnet status, RPC, and explorer links.">
  <article class="page-wrap-full">
    <header class="page-hero-full">
      <div class="page-wrap-inner">
        <span class="stage-badge-global">Testnet</span>
        <h1>Network Status</h1>
        <p class="lead">
          The public testnet RPC endpoint is <code>{TESTNET_RPC_URL}</code>; the live panel below shows whether it is reachable and when the latest block was produced (blocks are only produced when there are transactions). Use the
          <a href="https://boing.observer">Boing Observer</a> for blocks, accounts, tokens, and QA transparency, or query a node directly via
          <code>boing_chainHeight</code> and <code>boing_getNetworkInfo</code>.
        </p>
      </div>
    </header>
    <div class="page-wrap-inner status-content">
      <section class="live-status" aria-live="polite" data-rpc={TESTNET_RPC_URL} id="live-status">
        <h2>Live testnet</h2>
        <p class="live-state" data-field="state">Checking the public RPC…</p>
        <dl class="live-grid">
          <div><dt>Block height</dt><dd data-field="height">–</dd></div>
          <div><dt>Last block (idle is normal)</dt><dd data-field="lastblock">–</dd></div>
          <div><dt>Validators</dt><dd data-field="validators">–</dd></div>
          <div><dt>Total staked</dt><dd data-field="stake">–</dd></div>
          <div><dt>Chain ID</dt><dd data-field="chain">–</dd></div>
          <div><dt>Node version</dt><dd data-field="version">–</dd></div>
        </dl>
      </section>
      <ul class="status-links">
        <li><a href="https://boing.observer">Boing Observer (block explorer)</a></li>
        <li><a href="https://boing.observer/qa">QA transparency</a></li>
        <li><a href="https://boing.observer/tools/node-health">Node health (RPC probe)</a></li>
        <li><a href="/testnet/join">Join testnet</a> · <a href="/faucet">Faucet</a></li>
        <li><a href="/docs">Documentation</a> · <a href="https://github.com/Boing-Network/boing.network/blob/main/docs/TESTNET-RPC-INFRA.md" target="_blank" rel="noopener">Operator hub (TESTNET-RPC-INFRA)</a></li>
      </ul>
      <p class="status-note">
        Operator smoke from the monorepo: <code>npm run preflight-rpc</code>,
        <code>npm run verify-public-testnet-rpc</code>, <code>npm run verify-qa-alignment</code>,
        <code>npm run check-canonical-pool</code>, <code>npm run apply-public-testnet-qa-policy</code> (QA content blocklist).
      </p>
      <p class="status-note">Live chain metrics: <a href="https://boing.observer">Boing Observer</a> (blocks, accounts, QA registry) and <a href="https://boing.observer/tools/node-health">node health</a>.</p>
    </div>
  </article>
</Layout>

<script>
  const box = document.getElementById('live-status');
  const set = (k: string, v: string) => {
    const el = box?.querySelector('[data-field="' + k + '"]');
    if (el) el.textContent = v;
  };
  const RPC_TIMEOUT_MS = 15000;

  async function rpcPost(rpc: string, id: number, method: string, params: unknown[]) {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), RPC_TIMEOUT_MS);
    try {
      const res = await fetch(rpc, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ jsonrpc: '2.0', id, method, params }),
        signal: ctrl.signal,
      });
      let j: { result?: unknown; error?: { code?: number; message?: string } } | null = null;
      try {
        j = await res.json();
      } catch {
        j = null;
      }
      return { res, j };
    } finally {
      clearTimeout(timer);
    }
  }

  function sleep(ms: number) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  /** Format ledger/base-unit amount (u128 decimal string) as whole BOING for display. */
  function formatBoingFromLedger(raw: number | string, decimals: number): string {
    const text = typeof raw === 'string' ? raw.trim() : String(Math.trunc(Number(raw)));
    if (!/^-?\d+$/.test(text)) return '–';
    const units = BigInt(text);
    const neg = units < 0n;
    const abs = neg ? -units : units;
    const d = Number.isFinite(decimals) && decimals > 0 ? Math.floor(decimals) : 0;
    if (d === 0) {
      return (neg ? '-' : '') + abs.toLocaleString('en-US');
    }
    const base = 10n ** BigInt(d);
    const whole = abs / base;
    const frac = abs % base;
    let out = whole.toLocaleString('en-US');
    if (frac !== 0n) {
      // Keep up to 6 fractional digits; trim trailing zeros.
      const fracStr = frac.toString().padStart(d, '0').slice(0, 6).replace(/0+$/, '');
      if (fracStr) out += '.' + fracStr;
    }
    return (neg ? '-' : '') + out;
  }

  async function rpcPostWithBriefRetry(rpc: string, id: number, method: string, params: unknown[]) {
    let attempt = await rpcPost(rpc, id, method, params);
    if (attempt.res.status === 429) {
      const retryAfter = Number(attempt.res.headers.get('retry-after') || '2');
      const waitMs = Math.min(12_000, Math.max(1_000, (Number.isFinite(retryAfter) ? retryAfter : 2) * 1000));
      await sleep(waitMs);
      attempt = await rpcPost(rpc, id, method, params);
    }
    return attempt;
  }

  async function refresh() {
    const rpc = box?.getAttribute('data-rpc');
    if (!rpc) return;
    try {
      const { res, j } = await rpcPostWithBriefRetry(rpc, 1, 'boing_getNetworkInfo', []);
      if (res.status === 429 || j?.error?.code === -32016) {
        set(
          'state',
          'Public RPC is rate-limited at the edge for this IP (usually ~10 s). The node is likely fine — wait a moment and this panel will refresh.'
        );
        box?.setAttribute('data-state', 'limited');
        return;
      }
      if (!res.ok) throw new Error('http ' + res.status);
      const r = j && j.result;
      if (!r || typeof r !== 'object') throw new Error('no result');
      const info = r as {
        head_height?: number;
        consensus?: { validator_count?: number };
        chain_native?: { total_stake?: number | string };
        native_currency?: { decimals?: number; base_unit_decimals?: number };
        chain_id?: number;
        client_version?: string;
      };
      set('height', String(info.head_height ?? '–'));
      set('validators', String(info.consensus?.validator_count ?? '–'));
      const stake = info.chain_native?.total_stake;
      const decimals =
        info.native_currency?.decimals ?? info.native_currency?.base_unit_decimals ?? 18;
      set(
        'stake',
        stake != null ? formatBoingFromLedger(stake, decimals) + ' BOING' : '–'
      );
      set('chain', info.chain_id != null ? info.chain_id + ' (0x' + Number(info.chain_id).toString(16) + ')' : '–');
      set('version', String(info.client_version ?? '–'));
      let idle = false;
      try {
        const block = await rpcPost(rpc, 2, 'boing_getBlockByHeight', [info.head_height, false]);
        const ts = Number(
          (block.j?.result as { header?: { timestamp?: number } } | undefined)?.header?.timestamp
        );
        if (ts) {
          const ageMin = Math.max(0, Math.floor((Date.now() - ts * 1000) / 60000));
          set('lastblock', ageMin < 1 ? 'under a minute ago' : ageMin < 120 ? ageMin + ' min ago' : Math.floor(ageMin / 60) + ' h ago');
          idle = ageMin > 10;
        }
      } catch {
        set('lastblock', 'unavailable');
      }
      set(
        'state',
        idle
          ? 'RPC reachable · no transactions recently. The testnet only produces a block when there are transactions to include, so an old last block is normal. Updated ' + new Date().toLocaleTimeString()
          : 'RPC reachable · updated ' + new Date().toLocaleTimeString()
      );
      box?.setAttribute('data-state', 'ok');
    } catch (e) {
      const timedOut = e instanceof Error && e.name === 'AbortError';
      set(
        'state',
        timedOut
          ? 'Public RPC probe timed out. This is often a brief edge delay — check again in a minute.'
          : 'The public RPC is not responding right now. Wallets and the faucet will fail until it is back; check again in a minute.'
      );
      box?.setAttribute('data-state', 'down');
    }
  }
  refresh();
  setInterval(refresh, 30000);
</script>

<style>
  .live-status { border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 1rem 1.25rem; margin: 0 0 2rem; }
  .live-status h2 { margin: 0 0 0.25rem; font-size: 1.1rem; }
  .live-state { font-size: 0.9rem; margin: 0 0 0.75rem; }
  .live-status[data-state='down'] .live-state { color: #ffb4a8; }
  .live-status[data-state='limited'] .live-state { color: #ffd29a; }
  .live-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; margin: 0; }
  .live-grid dt { font-size: 0.8rem; color: var(--text-secondary); }
  .live-grid dd { margin: 0.15rem 0 0; font-size: 1.05rem; font-variant-numeric: tabular-nums; word-break: break-word; }
  .status-content { padding: 2rem 0 3rem; }
  .status-content p { color: var(--text-secondary); }
  .status-content a { color: var(--accent-teal); }
  .status-links { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: 0.75rem; }
  .status-note { font-size: 0.9rem; }
  .page-hero-full .lead code { background: rgba(255,255,255,0.08); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.9em; word-break: break-all; }
  .status-content { min-width: 0; }
  .status-note code { word-break: break-word; }
  @media (max-width: 640px) {
    .status-content { padding: 1.5rem 0 2.5rem; }
    .page-hero-full .lead { font-size: 1rem; }
  }
</style>
