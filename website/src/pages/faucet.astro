---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CopyButton from '../components/CopyButton.astro';
import { TESTNET_RPC_URL } from '../config/testnet';
---

<Layout
  title="Testnet Faucet"
  description="Request testnet BOING for the Boing Network testnet."
>
  <article class="page-wrap-full">
    <header class="page-hero-full">
      <div class="page-wrap-inner">
        <span class="stage-badge-global">Testnet</span>
        <h1 class="page-title"><Icon name="faucet" size={32} class="title-icon" /> Testnet Faucet</h1>
        <p class="lead">
          Get free testnet BOING to pay for fees. Paste your Boing address (or connect Boing Express) and request. Each request sends a fixed amount (currently <strong>10</strong> testnet BOING on the public testnet, rising to 20 with the next node update; the confirmation below shows the exact amount sent), limited to <strong>1 request per 60 seconds</strong> per address. A transfer costs about 1 BOING; deploying a native token costs about 10–20 BOING, so <strong>builders should plan on two requests</strong>.
        </p>
        <p class="lead no-wallet">
          No wallet yet? <a href="https://boing.express" target="_blank" rel="noopener">Create one at Boing Express</a> (web or Chrome extension), then come back. This is the canonical Boing faucet; the wallet and Boing Observer link here.
        </p>
      </div>
    </header>
    <div class="page-wrap-inner faucet-content">
      <section class="faucet-form">
      <label for="account-id">Your Boing address (32-byte account address, hex, with or without 0x)</label>
      <div class="input-with-copy">
        <input
          id="account-id"
          type="text"
          placeholder="0x..."
          maxlength="66"
          autocomplete="off"
          spellcheck="false"
        />
        <button id="connect-btn" type="button" class="secondary-btn">Use my Boing Express address</button>
      </div>
      <p id="connect-hint" class="hint" hidden></p>
      <details class="advanced">
        <summary>Advanced: RPC endpoint</summary>
      <div class="copy-wrapper input-group">
        <label for="rpc-url">Testnet RPC URL</label>
        <div class="input-with-copy">
          <input
            id="rpc-url"
            type="text"
            placeholder="https://testnet-rpc.boing.network or http://127.0.0.1:8545"
            value={TESTNET_RPC_URL}
          />
          <CopyButton label="Copy" copiedLabel="Copied!" />
        </div>
      </div>
      </details>
      <button id="request-btn" type="button" aria-busy="false">
        <span class="faucet-btn-inner">
          <span class="faucet-btn-label">Request testnet BOING</span>
          <span class="boing-loader boing-loader--sm faucet-inline-loader" hidden aria-hidden="true">
            <span class="boing-loader__dot"></span><span class="boing-loader__dot"></span><span class="boing-loader__dot"></span>
          </span>
        </span>
      </button>
      <p id="message" class="message" aria-live="polite" data-state=""></p>
      <div id="next-steps" class="next-steps" hidden>
        <strong>Next steps</strong>
        <ul>
          <li>Funds arrive in the next block (about 2 seconds). Check your balance in <a href="https://boing.express" target="_blank" rel="noopener">Boing Express</a>.</li>
          <li><a data-observer href="https://boing.observer" target="_blank" rel="noopener">View your account on Boing Observer</a>.</li>
          <li>Building? <a href="/developers/quickstart">Deploy a token with the <code>boing token</code> CLI</a>.</li>
        </ul>
      </div>
    </section>

    <section class="section">
      <h2>How it works</h2>
      <ul>
        <li>The faucet is an RPC method (<code>boing_faucetRequest</code>) on nodes started with <code>--faucet-enable</code>.</li>
        <li>Use the RPC URL of a testnet node that has the faucet enabled. For local testing, run <code>boing-node --validator --faucet-enable --rpc-port 8545</code> and use <code>http://127.0.0.1:8545</code>.</li>
        <li>Your account address is the 32-byte hex representation of your public key (e.g. from your wallet).</li>
      </ul>
    </section>

    <section class="section">
      <h2>Docs</h2>
      <p><a href="/testnet/join">Join Testnet</a> · <a href="/pdfs/TESTNET.pdf" target="_blank" rel="noopener">TESTNET (PDF)</a></p>
    </section>
    </div>
  </article>
</Layout>

<script>
  (function () {
    const rpcInput = document.getElementById('rpc-url') as HTMLInputElement;
    const accountInput = document.getElementById('account-id') as HTMLInputElement;
    const btn = document.getElementById('request-btn') as HTMLButtonElement;
    const messageEl = document.getElementById('message') as HTMLParagraphElement;
    const faucetLabel = btn?.querySelector('.faucet-btn-label');
    const faucetLoader = btn?.querySelector('.faucet-inline-loader') as HTMLElement | null;

    // Prefill account address from ?address= (e.g. from boing.observer or wallet deep link)
    const params = new URLSearchParams(window.location.search);
    const addressParam = params.get('address');
    if (accountInput && addressParam && /^(0x)?[0-9a-fA-F]{64}$/.test(addressParam.trim())) {
      accountInput.value = addressParam.trim().toLowerCase().startsWith('0x') ? addressParam.trim() : '0x' + addressParam.trim();
    }

    const nextEl = document.getElementById('next-steps') as HTMLElement | null;
    function showNextSteps(acct: string) {
      if (!nextEl) return;
      const link = nextEl.querySelector('a[data-observer]') as HTMLAnchorElement | null;
      if (link) link.href = 'https://boing.observer/account/' + encodeURIComponent(acct);
      nextEl.hidden = false;
    }

    const connectBtn = document.getElementById('connect-btn') as HTMLButtonElement | null;
    const connectHint = document.getElementById('connect-hint') as HTMLElement | null;
    connectBtn?.addEventListener('click', async () => {
      const provider = (window as unknown as { boing?: { request: (a: { method: string }) => Promise<unknown> } }).boing;
      if (!provider) {
        if (connectHint) {
          connectHint.hidden = false;
          connectHint.innerHTML =
            'Boing Express isn&#39;t installed in this browser. <a href="https://chromewebstore.google.com/detail/boing-express/hhknjdhknnghccmfnfafbkapjljicbfh" target="_blank" rel="noopener">Install the Chrome extension</a>, or open <a href="https://boing.express" target="_blank" rel="noopener">boing.express</a> and copy your address here.';
        }
        return;
      }
      try {
        const accounts = (await provider.request({ method: 'boing_requestAccounts' })) as string[];
        const first = Array.isArray(accounts) ? accounts[0] : undefined;
        if (first && accountInput) {
          accountInput.value = first.startsWith('0x') ? first : '0x' + first;
          if (connectHint) connectHint.hidden = true;
        }
      } catch (e) {
        if (connectHint) {
          connectHint.hidden = false;
          connectHint.textContent = 'Connection was cancelled or failed: ' + (e instanceof Error ? e.message : String(e));
        }
      }
    });

    function setMessage(text: string, isError = false) {
      messageEl.textContent = text;
      messageEl.setAttribute('data-state', isError ? 'error' : 'success');
      messageEl.style.color = '';
    }

    btn?.addEventListener('click', async () => {
      const rpcUrl = (rpcInput?.value || '').trim().replace(/\/$/, '');
      let accountHex = (accountInput?.value || '').trim();
      if (!rpcUrl) {
        setMessage('Please enter the Testnet RPC URL.', true);
        return;
      }
      if (!accountHex) {
        setMessage('Please enter your account address (32-byte hex).', true);
        return;
      }
      if (!accountHex.startsWith('0x')) accountHex = '0x' + accountHex;
      if (accountHex.length !== 66) {
        setMessage('Account address must be 32 bytes (64 hex chars + 0x).', true);
        return;
      }

      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      if (faucetLabel) (faucetLabel as HTMLElement).textContent = 'Requesting…';
      if (faucetLoader) faucetLoader.hidden = false;
      setMessage('Requesting…');

      try {
        const res = await fetch(rpcUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jsonrpc: '2.0',
            id: 1,
            method: 'boing_faucetRequest',
            params: [accountHex],
          }),
        });
        const data = await res.json();

        if (data.error) {
          setMessage(data.error.message || 'Request failed.', true);
          return;
        }
        if (data.result?.ok) {
          const tip =
            typeof data.result.tip_height === 'number' ? ` Tip height: ${data.result.tip_height}.` : '';
          const warn = data.result.warning
            ? ` Warning: ${data.result.warning}`
            : '';
          const base = `Faucet accepted ${data.result.amount} testnet BOING into the mempool. ${data.result.message || ''}${tip}${warn}`;
          setMessage(base, Boolean(data.result.warning));
          showNextSteps(accountHex);
        } else {
          setMessage(data.result?.message || 'Request may have succeeded; check your wallet.', false);
        }
      } catch (e) {
        setMessage('Network error: ' + (e instanceof Error ? e.message : String(e)), true);
      } finally {
        btn.disabled = false;
        btn.setAttribute('aria-busy', 'false');
        if (faucetLabel) (faucetLabel as HTMLElement).textContent = 'Request testnet BOING';
        if (faucetLoader) {
          faucetLoader.hidden = true;
          faucetLoader.setAttribute('aria-hidden', 'true');
        }
      }
    });
  })();
</script>

<style>
  .faucet-content { padding-bottom: 3rem; max-width: 640px; }
  .page-title { display: flex; align-items: center; gap: 0.5rem; color: var(--text-primary); }
  .title-icon { color: var(--accent-teal); flex-shrink: 0; }
  .faucet-page h1 { color: var(--text-primary); }
  .lead { color: var(--text-secondary); font-size: 1.05rem; margin-bottom: 1.5rem; }
  .faucet-form label { display: block; margin-top: 1rem; color: var(--text-secondary); font-size: 0.9rem; }
  .faucet-form .input-with-copy {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    flex-wrap: wrap;
  }
  .faucet-form .input-with-copy input { flex: 1; min-width: 200px; }
  @media (max-width: 360px) {
    .faucet-form .input-with-copy { flex-direction: column; align-items: stretch; }
    .faucet-form .input-with-copy input { min-width: 0; }
  }
  .faucet-form input {
    width: 100%;
    max-width: 100%;
    padding: 12px 16px;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }
  .faucet-form input:focus {
    outline: none;
    border-color: var(--accent-teal);
    box-shadow: 0 0 8px var(--glow-cyan);
  }
  .faucet-form input::placeholder {
    color: var(--text-tertiary);
  }
  .faucet-form button {
    margin-top: 1.25rem;
    padding: 0.6rem 1.2rem;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--accent-teal), var(--accent-cyan));
    color: var(--bg-primary);
    cursor: pointer;
  }
  .faucet-form button:hover:not(:disabled) { opacity: 0.9; }
  .faucet-form button:disabled { opacity: 0.6; cursor: not-allowed; }
  .faucet-form button[aria-busy="true"] {
    position: relative;
  }
  .faucet-btn-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .faucet-inline-loader[hidden] {
    display: none !important;
  }
  .faucet-inline-loader:not([hidden]) {
    display: inline-flex !important;
  }
  .secondary-btn { margin-top: 0.25rem !important; background: transparent !important; border: 1px solid var(--accent-teal) !important; color: var(--accent-teal) !important; font-size: 0.85rem !important; padding: 0.55rem 0.9rem !important; white-space: nowrap; }
  .hint { margin-top: 0.5rem; font-size: 0.85rem; color: var(--text-secondary); }
  .advanced { margin-top: 1rem; color: var(--text-secondary); }
  .advanced summary { cursor: pointer; font-size: 0.9rem; }
  .next-steps { margin-top: 1rem; padding: 0.9rem 1rem; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-secondary); }
  .next-steps ul { margin: 0.4rem 0 0; padding-left: 1.1rem; }
  .no-wallet { font-size: 0.95rem; }
  .message { margin-top: 1rem; min-height: 1.5em; font-size: 0.95rem; }
  .message[data-state="success"] { color: var(--accent-teal); font-weight: 500; }
  .message[data-state="error"] { color: var(--error-color, #f87171); }
  .section { margin-top: 2rem; }
  .section h2 { font-size: 1.2rem; color: var(--text-primary); }
  .section p, .section li { color: var(--text-secondary); }
  .section code { background: rgba(255,255,255,0.08); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
</style>
