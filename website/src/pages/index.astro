      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp' && e.key !== ' ' && e.key !== 'PageDown' && e.key !== 'PageUp') return;
      const i = findCurrentIndex();
      const section = sections[i];
      const rect = section.getBoundingClientRect();
      const sectionTallerThanView = rect.height > window.innerHeight;

      if (e.key === 'ArrowDown' || e.key === 'PageDown' || (e.key === ' ' && !e.shiftKey)) {
        e.preventDefault();
        if (sectionTallerThanView && !atBottomOfSection(section)) {
          const step = Math.min(window.innerHeight * STEP, rect.bottom - window.innerHeight - 20);
          if (step > 10) window.scrollBy({ top: step, behavior: 'smooth' });
          else goToSection(Math.min(i + 1, sections.length - 1));
        } else {
          goToSection(Math.min(i + 1, sections.length - 1));
        }
      } else if (e.key === 'ArrowUp' || e.key === 'PageUp' || (e.key === ' ' && e.shiftKey)) {
        e.preventDefault();
        if (sectionTallerThanView && !atTopOfSection(section)) {
          const step = Math.min(window.innerHeight * STEP, rect.top - NAV_OFFSET + 20);
          if (step > 10) window.scrollBy({ top: -step, behavior: 'smooth' });
          else goToSection(Math.max(i - 1, 0));
        } else {
          goToSection(Math.max(i - 1, 0));
        }
      }
    });
  })();
