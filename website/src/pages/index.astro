<script>
  /** Homepage scroll: section-by-section, but scroll within tall sections first so all content is viewable. */
  (() => {
    if (!document.documentElement.classList.contains('page-home')) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const sections = Array.from(document.querySelectorAll('.hero, .section'));
    if (sections.length < 2) return;

    let cooldown = false;
    const COOLDOWN_MS = 500;
    const NAV_OFFSET = 4.5 * 16; // match scroll-margin-top (72px)
    const THRESHOLD = 40;
    const STEP = 0.75; // fraction of viewport to scroll within section

    let wheelScheduled = false;
    let lastDelta = 0;

    function findCurrentIndex() {
      const mid = window.innerHeight * 0.4;
      for (let i = sections.length - 1; i >= 0; i--) {
        if (sections[i].getBoundingClientRect().top <= mid) return i;
      }
      return 0;
    }

    function goToSection(index) {
      if (index < 0 || index >= sections.length) return;
      sections[index].scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function atTopOfSection(section) {
      const rect = section.getBoundingClientRect();
      return rect.top >= NAV_OFFSET - THRESHOLD;
    }

    function atBottomOfSection(section) {
      const rect = section.getBoundingClientRect();
      return rect.bottom <= window.innerHeight + THRESHOLD;
    }

    function runWheelAction() {
      wheelScheduled = false;
      const delta = lastDelta;
      if (cooldown || Math.abs(delta) < 20) return;

      const i = findCurrentIndex();
      const section = sections[i];
      const rect = section.getBoundingClientRect();
      const sectionTallerThanView = rect.height > window.innerHeight;

      if (delta > 0) {
        if (sectionTallerThanView && !atBottomOfSection(section)) {
          const step = Math.min(window.innerHeight * STEP, rect.bottom - window.innerHeight - 20);
          if (step > 10) {
            window.scrollBy({ top: step, behavior: 'smooth' });
            cooldown = true;
            setTimeout(() => { cooldown = false; }, COOLDOWN_MS);
            return;
          }
        }
        goToSection(Math.min(i + 1, sections.length - 1));
      } else {
        if (sectionTallerThanView && !atTopOfSection(section)) {
          const step = Math.min(window.innerHeight * STEP, rect.top - NAV_OFFSET + 20);
          if (step > 10) {
            window.scrollBy({ top: -step, behavior: 'smooth' });
            cooldown = true;
            setTimeout(() => { cooldown = false; }, COOLDOWN_MS);
            return;
          }
        }
        goToSection(Math.max(i - 1, 0));
      }

      cooldown = true;
      setTimeout(() => { cooldown = false; }, COOLDOWN_MS);
    }

    window.addEventListener('wheel', (e) => {
      lastDelta = e.deltaY;
      if (cooldown) {
        e.preventDefault();
        return;
      }
      if (Math.abs(lastDelta) < 20) return;
      e.preventDefault();
      if (!wheelScheduled) {
        wheelScheduled = true;
        requestAnimationFrame(runWheelAction);
      }
    }, { passive: false });

