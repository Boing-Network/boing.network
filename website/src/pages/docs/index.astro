<script>
  (function () {
    const sectionIds = ['overview', 'getting-started', 'network-overview', 'tokenomics', 'architecture', 'rpc-api', 'operations', 'roadmap', 'testnet', 'security', 'governance', 'responsive', 'resources'];
    const contentEl = document.querySelector('.docs-content');
    const tocPanel = document.querySelector('.toc-panel');

    function closeMobileToc() {
      if (!tocPanel || window.matchMedia('(min-width: 901px)').matches) return;
      tocPanel.open = false;
    }

    function showSection(id, opts) {
      const scrollTop = !opts || opts.scrollTop !== false;
      const sections = document.querySelectorAll('.doc-section');
      const links = document.querySelectorAll('.toc-link');
      sections.forEach((el) => el.classList.toggle('active', el.id === id));
      links.forEach((a) => a.classList.toggle('active', (a.getAttribute('href') || '').slice(1) === id));
      if (id) window.history.replaceState(null, '', window.location.pathname + '#' + id);
      if (scrollTop && contentEl) contentEl.scrollTop = 0;
      closeMobileToc();
    }
    function getSectionFromHash() {
      const hash = window.location.hash.slice(1);
      return sectionIds.includes(hash) ? hash : 'overview';
    }
    document.querySelectorAll('.toc-link').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const id = (a.getAttribute('href') || '').slice(1);
        if (sectionIds.includes(id)) showSection(id);
      });
    });
    window.addEventListener('hashchange', () => showSection(getSectionFromHash()));
    showSection(getSectionFromHash(), { scrollTop: false });

    // Keep desktop TOC panel open; allow accordion collapse only on smaller viewports.
    function syncTocOpenState() {
      if (!tocPanel) return;
      if (window.matchMedia('(min-width: 901px)').matches) tocPanel.open = true;
    }
    syncTocOpenState();
    window.addEventListener('resize', syncTocOpenState);
    // Semantic link colors + click-to-copy toast: Layout loads /js/semantic-links.js
  })();
</script>

