            <tr><td><code>boing_getBalance</code></td><td><code>[hex_account_id]</code></td><td>Result: <code>balance</code> (u128 decimal string).</td></tr>
            <tr><td><code>boing_getAccount</code></td><td><code>[hex_account_id]</code></td><td><code>balance</code>, <code>nonce</code>, <code>stake</code>.</td></tr>
            <tr><td><code>boing_getBlockByHeight</code></td><td><code>[height]</code> or <code>[height, include_receipts]</code></td><td>Block or <code>null</code>.</td></tr>
