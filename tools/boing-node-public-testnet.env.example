# Copy or merge into your process manager (systemd, Docker, shell) for **public Boing testnet** JSON-RPC.
# `boing_getNetworkInfo` returns `chain_id` / `chain_name` from these variables.
# Ready-made wiring: boing-node-public-testnet.systemd.example, boing-node-public-testnet.docker-compose.yml,
# boing-node-public-testnet.kubernetes.example.yaml (same repo tools/).
#
# Canonical testnet chain id (same as wallet `boing_chainId` 0x1b01): docs/RPC-API-SPEC.md, docs/TESTNET.md

BOING_CHAIN_ID=6913
BOING_CHAIN_NAME=Boing Testnet

# Optional: publish canonical native DEX contract AccountIds for dApps (boing_getNetworkInfo.end_user).
# Live public testnet values (2026-05-21) — docs/NATIVE-DEX-OPERATOR-DEPLOYMENT-RECORD.md Appendix B.
BOING_CANONICAL_NATIVE_CP_POOL=0x5b60d6f8514d1a8a40340fa354951d778b0821cd3ff7e534d0bea50f67d38976
BOING_CANONICAL_NATIVE_DEX_FACTORY=0x7322ccec1ffdbf25d3f60384db0f9a38f8d6121233daccd48d4477d6036aff2a
BOING_CANONICAL_NATIVE_DEX_MULTIHOP_SWAP_ROUTER=0xd8504729900a2d6dc8b8afc7bf24a18dc08732d24a4d2e3555ea5b7f28f3672c
BOING_CANONICAL_NATIVE_DEX_LEDGER_ROUTER_V2=0xd39d7bb18e986a6e39a69521d9b6f1fe403ff757ee8d409b89f2bcccc4df7980
BOING_CANONICAL_NATIVE_DEX_LEDGER_ROUTER_V3=0x082a13685fbb69999f2d1378b2f704f3103ae6929b18a87510b513cb790c53c9
BOING_CANONICAL_NATIVE_AMM_LP_VAULT=0xac7a635931b192f5cff054e9994242f54fbda579a46eba21d9787600971ec90f
BOING_CANONICAL_NATIVE_LP_SHARE_TOKEN=0x2f460046eb700ff8c7eebe6f4c409465a9111f32210edcc478a2a0de9d0ec2db
# --- DEX L1 discovery tuning (optional; matches node built-in defaults when omitted) ---
# See docs/RPC-API-SPEC.md § boing_listDexPools / boing_listDexTokens. Public RPC: set explicitly so behavior is obvious in `systemctl show` / compose files.
# Recent blocks (newest-first) scanned for ContractDeployWithPurposeAndMetadata symbol/name on listDexTokens / getDexToken (max 500000).
BOING_DEX_TOKEN_METADATA_SCAN_BLOCKS=8192
# Cap receipt rows examined per discovery RPC for factory Log3 register heights (createdAtHeight / firstSeenHeight). 0 = unlimited (operator discretion).
BOING_DEX_DISCOVERY_MAX_RECEIPT_SCANS=500000
# JSON object: "0x" + 64 hex (token AccountId) -> decimals 0–255. {} defers to default 18 for every token; add keys for non-18 canonical assets.
BOING_DEX_TOKEN_DECIMALS_JSON={}

# Optional (dApps / scripts — not read by boing-node): Cloudflare Worker origin for native DEX indexer D1 directory API.
# See docs/HANDOFF_NATIVE_DEX_DIRECTORY_R2_AND_CHAIN.md; boing-sdk nativeDexDirectoryApi.ts; npm run verify-native-dex-directory-worker
# BOING_NATIVE_DEX_DIRECTORY_BASE_URL=https://boing-native-dex-indexer.example.workers.dev

# Optional: strict JSON-RPC rate profile (default without BOING_RATE_PROFILE is mainnet-style).
# BOING_RATE_PROFILE=mainnet

# --- Fee market (micro base + optional priority tip) ---
# Product target: Solana-like micro fees (execution_gas_fee_bps=100 → ~0.00021 BOING/transfer), not gasless.
# On public testnet (ExecutionHistory), reduced BPS is ignored until this height (replay-safe).
# Set to the current tip (or tip+1) when first enabling micro fees, then apply micro_fee_default()
# via network_fee_config.json / boing_operatorApplyFeePolicy. See docs/OPTIONAL-PRIORITY-FEES.md.
# BOING_MICRO_FEES_ACTIVATION_HEIGHT=0
# CLI equivalent: --micro-fees-activation-height


# --- Operator RPC (fail-closed) ---
# Operator-only methods (boing_operatorApplyFeePolicy, boing_operatorApplyQaPolicy, slash appeals,
# boing_registerBlsDualKey, boing_putBlobSampleOffer, admin-only boing_qaPoolVote) require this token
# sent as the X-Boing-Operator header. When it is unset they are rejected with -32057.
# On mainnet (chain id 6914) the node refuses to start without it. Keep it in a secret store.
# BOING_OPERATOR_RPC_TOKEN=

# --- L1 media blobs (optional) ---
# BOING_MEDIA_BLOBS_ACTIVATION_HEIGHT=1
# BOING_BLOBS_ROOT_HEADER_ACTIVATION_HEIGHT=1
#
# Dedicated raw-byte download: GET /v1/media/blob?id=<blobId> (bypasses JSON-RPC hex + public gateway 6 MiB).
# When BOING_OPERATOR_RPC_TOKEN and/or BOING_BLOB_DOWNLOAD_TOKENS are set, the download endpoint requires a matching
# X-Boing-Operator, X-Boing-Blob-Download, or Authorization: Bearer (this gate is separate from the fail-closed operator RPC methods).
# BOING_BLOB_DOWNLOAD_TOKENS=download-token-1,download-token-2
# Optional: also gate JSON-RPC boing_getBlob with the same credentials (default off — NFT/SDK meta stays public).
# BOING_BLOB_GET_REQUIRE_AUTH=1
#
# Phase 7–10 gated 256 MiB raise — KEEP UNSET on public testnet / Fly until coordinated.
# Default = 16 MiB (Fly-safe). Mismatched heights across validators fork admission.
# Checklist (also in boing_getMediaBlobParams.capActivationChecklist / docs/BOING-L1-MEDIA-BLOBS.md):
#   1) Pre-flight: Fly disk, RPC body limits, indexer timeouts for 256 MiB
#   2) Same binary on all validators/RPC nodes
#   3) Roll order: deploy → confirm → set identical H → restart all → verify params → load-test
#   4) After tip>=H: phase7CapActiveAtTip=true, effectiveMaxBytesAtTip=268435456
#   5) Never partial-unset after tip>=H; monitor OOM / admission rejects
#   6) Record H here once activated
# BOING_MEDIA_BLOBS_PHASE7_CAP_ACTIVATION_HEIGHT=

# Phase 32: opt-in flip of multi-pin committee verify from Ed25519 tx 32 → BLS aggregate tx 33.
# Leave unset by default (identical to Phase 31 — multi-pin default stays Ed25519 32).
# Only set identical H on all validators after dual-key + tx 33 operational readiness.
# BOING_MEDIA_BLOBS_BLS_COMMITTEE_FLIP_HEIGHT=
