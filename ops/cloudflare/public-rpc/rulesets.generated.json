{
  "$comment": "GENERATED by scripts/public-rpc-edge.mjs from ops/cloudflare/public-rpc/policy.json. Do not edit. Apply with: node scripts/public-rpc-edge.mjs apply (dry-run unless --apply).",
  "host": "testnet-rpc.boing.network",
  "zone_name": "boing.network",
  "phases": {
    "http_ratelimit": [
      {
        "ref": "boing_public_rpc_rl_burst",
        "description": "Public RPC: per-IP burst limit (60 POST / 10s)",
        "expression": "(http.host eq \"testnet-rpc.boing.network\" and http.request.method eq \"POST\")",
        "action": "log",
        "ratelimit": {
          "characteristics": [
            "cf.colo.id",
            "ip.src"
          ],
          "period": 10,
          "requests_per_period": 60,
          "mitigation_timeout": 60
        },
        "enabled": true
      },
      {
        "ref": "boing_public_rpc_rl_sustained",
        "description": "Public RPC: per-IP sustained limit (300 POST / 60s)",
        "expression": "(http.host eq \"testnet-rpc.boing.network\" and http.request.method eq \"POST\")",
        "action": "log",
        "ratelimit": {
          "characteristics": [
            "cf.colo.id",
            "ip.src"
          ],
          "period": 60,
          "requests_per_period": 300,
          "mitigation_timeout": 120
        },
        "enabled": true
      }
    ],
    "http_request_firewall_custom": [
      {
        "ref": "boing_public_rpc_block_http_methods",
        "description": "Public RPC: only POST, GET, HEAD and OPTIONS",
        "expression": "(http.host eq \"testnet-rpc.boing.network\" and not http.request.method in {\"POST\" \"GET\" \"HEAD\" \"OPTIONS\"})",
        "action": "block",
        "enabled": true
      },
      {
        "ref": "boing_public_rpc_block_operator_header",
        "description": "Public RPC: operator RPC must use the origin, never the public hostname",
        "expression": "(http.host eq \"testnet-rpc.boing.network\" and len(http.request.headers[\"x-boing-operator\"]) gt 0)",
        "action": "block",
        "enabled": true
      }
    ]
  }
}
