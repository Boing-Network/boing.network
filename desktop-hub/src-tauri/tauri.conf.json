{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boing Network Hub",
  "version": "0.1.27",
  "identifier": "network.boing.hub",
  "mainBinaryName": "boing-network-hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* http://localhost:* https://testnet-rpc.boing.network https://*.boing.network https://boing.network https://boing.express https://boing.observer https://boing.finance",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob: https:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "frame-src": "'self' https://boing.observer https://boing.express https://boing.finance https://boing.network https://*.boing.network http://localhost:* http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Boing Network Hub",
        "url": "/app",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": true
      },
      {
        "label": "splashscreen",
        "title": "Boing Network Hub",
        "url": "/splash",
        "width": 420,
        "height": 320,
        "resizable": false,
        "center": true,
        "visible": true,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "https://timestamp.digicert.com",
      "wix": null,
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "longDescription": "All-in-one desktop hub for the Boing Network ecosystem: Observer (block explorer), Express (wallet), and Finance (DEX).",
    "shortDescription": "Boing Network desktop hub",
    "category": "Finance",
    "copyright": "",
    "licenseFile": null,
    "resources": [],
    "externalBin": [],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "shell": {
      "open": "^https://([a-z0-9-]+\\.)*boing\\.(network|express|observer|finance)(/.*)?$|^https?://(localhost|127\\.0\\.0\\.1)(:\\d+)?(/.*)?$"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzRDM3QTMzNTA1RjM3RTUKUldUbE4xOVFNM3JURTVPNS9PVTRPNEkzNzFxdlZYUll0WXBBR3NTL3J2QmRHWkdVcFZSbUtQWU4K",
      "endpoints": [
        "https://boing.network/hub-updater/latest.json",
        "https://github.com/Boing-Network/boing.network/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
